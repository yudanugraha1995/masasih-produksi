[{"s": 0, "e": 1.614, "t": "Is Hawaiian pizza actually"}, {"s": 1.614, "e": 3.134, "t": "from Hawaii?"}, {"s": 3.134, "e": 4.201, "t": "Let's look at pizza"}, {"s": 4.201, "e": 5.703, "t": "around the world."}, {"s": 5.703, "e": 6.855, "t": "Australia:"}, {"s": 6.855, "e": 7.666, "t": "egg on pizza is"}, {"s": 7.666, "e": 8.434, "t": "a thing,"}, {"s": 8.434, "e": 10.391, "t": "and so are prawns!"}, {"s": 10.391, "e": 11.201, "t": "Japan:"}, {"s": 11.201, "e": 11.841, "t": "mayo,"}, {"s": 11.841, "e": 13.335, "t": "corn and even squid,"}, {"s": 13.335, "e": 14.487, "t": "sometimes all on one"}, {"s": 14.487, "e": 15.791, "t": "pizza!"}, {"s": 15.791, "e": 16.473, "t": "Sweden:"}, {"s": 16.473, "e": 18.009, "t": "banana and curry pizza,"}, {"s": 18.009, "e": 19.161, "t": "a classic at Swedish"}, {"s": 19.161, "e": 20.659, "t": "pizzerias!"}, {"s": 20.659, "e": 21.385, "t": "Italy:"}, {"s": 21.385, "e": 22.409, "t": "the Margherita,"}, {"s": 22.409, "e": 23.049, "t": "said to be named"}, {"s": 23.049, "e": 24.656, "t": "after a queen."}, {"s": 24.656, "e": 25.552, "t": "Canada:"}, {"s": 25.552, "e": 26.917, "t": "Hawaiian pizza was invented"}, {"s": 26.917, "e": 28.155, "t": "in Ontario in nineteen"}, {"s": 28.155, "e": 29.179, "t": "sixty two,"}, {"s": 29.179, "e": 31.238, "t": "by a Greek immigrant!"}, {"s": 31.238, "e": 33.089, "t": "But here's the twist."}, {"s": 33.089, "e": 33.857, "t": "America:"}, {"s": 33.857, "e": 35.222, "t": "eats about three billion"}, {"s": 35.222, "e": 36.289, "t": "pizzas a year,"}, {"s": 36.289, "e": 37.355, "t": "that's around three hundred"}, {"s": 37.355, "e": 39.105, "t": "fifty slices every second,"}, {"s": 39.105, "e": 40.257, "t": "and pepperoni is the"}, {"s": 40.257, "e": 41.824, "t": "top topping!"}, {"s": 41.824, "e": 42.933, "t": "Pineapple on pizza,"}, {"s": 42.933, "e": 44.407, "t": "yes or no?"}, {"s": 44.407, "e": 45.261, "t": "Comment below,"}, {"s": 45.261, "e": 46.54, "t": "and subscribe for more!"}]