[{"s": 0.204, "e": 1.44, "t": "Minum sambil berdiri katanya"}, {"s": 1.48, "e": 2.64, "t": "bikin ginjal rusak!"}, {"s": 7.57, "e": 8.14, "t": "Masa sih?"}, {"s": 13.12, "e": 14.04, "t": "Faktanya,"}, {"s": 14.12, "e": 15.08, "t": "air yang kamu minum"}, {"s": 15.14, "e": 16.04, "t": "masuk ke lambung dan"}, {"s": 16.093, "e": 16.92, "t": "usus dulu,"}, {"s": 16.984, "e": 18.44, "t": "baru diserap ke darah."}, {"s": 23.16, "e": 24.5, "t": "Ginjal nyaring darah,"}, {"s": 24.54, "e": 25.7, "t": "jadi posisi minum nggak"}, {"s": 25.727, "e": 26.42, "t": "ngaruh."}, {"s": 31.408, "e": 32.08, "t": "Plot twist-nya,"}, {"s": 32.112, "e": 33.12, "t": "yang bahaya itu minum"}, {"s": 33.16, "e": 34.48, "t": "buru-buru sambil jalan,"}, {"s": 34.544, "e": 36.0, "t": "bisa bikin tersedak!"}, {"s": 41.215, "e": 42.06, "t": "Kamu tim minum duduk"}, {"s": 42.108, "e": 43.38, "t": "atau tim minum berdiri?"}, {"s": 48.05, "e": 49.0, "t": "Tulis di komentar!"}]