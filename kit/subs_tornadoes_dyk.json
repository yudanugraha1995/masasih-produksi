[{"s": 0, "e": 0.931, "t": "What if a tornado"}, {"s": 0.931, "e": 2.566, "t": "could hit your town?"}, {"s": 2.566, "e": 4.453, "t": "Let's count tornadoes."}, {"s": 4.453, "e": 5.519, "t": "The UK:"}, {"s": 5.519, "e": 6.757, "t": "about thirty a year,"}, {"s": 6.757, "e": 7.738, "t": "and for its size"}, {"s": 7.738, "e": 8.207, "t": "it's one of the"}, {"s": 8.207, "e": 9.445, "t": "most tornado packed countries"}, {"s": 9.445, "e": 10.795, "t": "on Earth!"}, {"s": 10.795, "e": 11.733, "t": "Canada:"}, {"s": 11.733, "e": 12.971, "t": "around sixty confirmed a"}, {"s": 12.971, "e": 13.44, "t": "year,"}, {"s": 13.44, "e": 14.293, "t": "the second most in"}, {"s": 14.293, "e": 15.638, "t": "the world."}, {"s": 15.638, "e": 16.705, "t": "Japan:"}, {"s": 16.705, "e": 17.601, "t": "about twenty five a"}, {"s": 17.601, "e": 17.985, "t": "year,"}, {"s": 17.985, "e": 19.35, "t": "many starting as waterspouts"}, {"s": 19.35, "e": 20.685, "t": "over the sea."}, {"s": 20.685, "e": 21.794, "t": "Bangladesh:"}, {"s": 21.794, "e": 22.775, "t": "hit by the deadliest"}, {"s": 22.775, "e": 23.586, "t": "tornado ever,"}, {"s": 23.586, "e": 24.951, "t": "in nineteen eighty nine,"}, {"s": 24.951, "e": 26.189, "t": "killing about thirteen hundred"}, {"s": 26.189, "e": 27.363, "t": "people."}, {"s": 27.363, "e": 28.301, "t": "Australia:"}, {"s": 28.301, "e": 29.283, "t": "dozens a year,"}, {"s": 29.283, "e": 30.563, "t": "plus giant dust devils"}, {"s": 30.563, "e": 32.477, "t": "called willy willies!"}, {"s": 32.477, "e": 34.391, "t": "But here's the twist."}, {"s": 34.391, "e": 35.244, "t": "America:"}, {"s": 35.244, "e": 36.524, "t": "over twelve hundred tornadoes"}, {"s": 36.524, "e": 37.292, "t": "a year,"}, {"s": 37.292, "e": 38.273, "t": "about three quarters of"}, {"s": 38.273, "e": 39.425, "t": "all the tornadoes reported"}, {"s": 39.425, "e": 40.279, "t": "on Earth,"}, {"s": 40.279, "e": 42.331, "t": "mostly in Tornado Alley!"}, {"s": 42.331, "e": 43.013, "t": "Would you ever chase"}, {"s": 43.013, "e": 44.527, "t": "a tornado?"}, {"s": 44.527, "e": 45.295, "t": "Comment below,"}, {"s": 45.295, "e": 46.532, "t": "and subscribe for more!"}]