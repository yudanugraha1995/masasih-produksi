[{"s": 0, "e": 0.803, "t": "What if the clocks"}, {"s": 0.803, "e": 2.406, "t": "never changed?"}, {"s": 2.406, "e": 3.793, "t": "Let's check."}, {"s": 3.793, "e": 5.116, "t": "Australia:"}, {"s": 5.116, "e": 6.567, "t": "only some states change,"}, {"s": 6.567, "e": 7.591, "t": "so in summer,"}, {"s": 7.591, "e": 8.785, "t": "Queensland and New South"}, {"s": 8.785, "e": 9.809, "t": "Wales are an hour"}, {"s": 9.809, "e": 11.154, "t": "apart!"}, {"s": 11.154, "e": 12.093, "t": "The UK:"}, {"s": 12.093, "e": 12.477, "t": "yes,"}, {"s": 12.477, "e": 13.501, "t": "it switches to British"}, {"s": 13.501, "e": 15.595, "t": "Summer Time every March."}, {"s": 15.595, "e": 16.705, "t": "Japan:"}, {"s": 16.705, "e": 17.259, "t": "no,"}, {"s": 17.259, "e": 19.344, "t": "the clocks never change."}, {"s": 19.344, "e": 20.283, "t": "China:"}, {"s": 20.283, "e": 20.453, "t": "no,"}, {"s": 20.453, "e": 21.435, "t": "it stopped in nineteen"}, {"s": 21.435, "e": 22.899, "t": "ninety one."}, {"s": 22.899, "e": 23.71, "t": "Russia:"}, {"s": 23.71, "e": 24.947, "t": "tried permanent summer time"}, {"s": 24.947, "e": 26.099, "t": "in twenty eleven,"}, {"s": 26.099, "e": 26.654, "t": "then gave it up"}, {"s": 26.654, "e": 28.572, "t": "in twenty fourteen!"}, {"s": 28.572, "e": 30.42, "t": "But here's the twist."}, {"s": 30.42, "e": 31.359, "t": "America:"}, {"s": 31.359, "e": 32.383, "t": "still changes twice a"}, {"s": 32.383, "e": 33.023, "t": "year,"}, {"s": 33.023, "e": 34.473, "t": "except Hawaii and most"}, {"s": 34.473, "e": 35.839, "t": "of Arizona,"}, {"s": 35.839, "e": 36.649, "t": "even though the Senate"}, {"s": 36.649, "e": 37.503, "t": "voted to make summer"}, {"s": 37.503, "e": 38.527, "t": "time permanent back in"}, {"s": 38.527, "e": 40.272, "t": "twenty twenty two!"}, {"s": 40.272, "e": 42.393, "t": "Should clocks still change?"}, {"s": 42.393, "e": 43.375, "t": "Comment below,"}, {"s": 43.375, "e": 44.612, "t": "and subscribe for more!"}]