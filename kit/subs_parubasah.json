[{"s": 0, "e": 1.6, "t": "Habis olahraga keringetan,"}, {"s": 1.72, "e": 2.64, "t": "langsung mandi,"}, {"s": 2.72, "e": 3.52, "t": "terus diomelin:"}, {"s": 3.54, "e": 4.9, "t": "nanti paru-paru basah!"}, {"s": 5.0, "e": 5.72, "t": "Masa sih?"}, {"s": 5.9, "e": 6.78, "t": "Faktanya,"}, {"s": 6.86, "e": 8.3, "t": "paru-paru basah itu sebutan"}, {"s": 8.38, "e": 9.9, "t": "awam untuk pneumonia,"}, {"s": 9.94, "e": 11.42, "t": "yaitu infeksi paru,"}, {"s": 11.5, "e": 12.94, "t": "atau cairan yang menumpuk"}, {"s": 12.98, "e": 13.94, "t": "di sekitar paru."}, {"s": 14.14, "e": 15.66, "t": "Penyebabnya bakteri,"}, {"s": 15.7, "e": 16.14, "t": "virus,"}, {"s": 16.22, "e": 17.02, "t": "atau jamur,"}, {"s": 17.1, "e": 18.14, "t": "bukan air mandi."}, {"s": 18.24, "e": 19.28, "t": "Air mandi nggak bisa"}, {"s": 19.36, "e": 20.4, "t": "masuk ke paru-paru lewat"}, {"s": 20.48, "e": 20.96, "t": "kulit."}, {"s": 21.06, "e": 22.34, "t": "Tapi ada yang perlu"}, {"s": 22.42, "e": 23.14, "t": "diperhatikan."}, {"s": 23.24, "e": 24.6, "t": "Habis olahraga berat,"}, {"s": 24.68, "e": 26.36, "t": "jantung masih berdetak kencang."}, {"s": 26.38, "e": 27.5, "t": "Langsung kena air dingin"}, {"s": 27.58, "e": 28.7, "t": "bisa bikin pembuluh darah"}, {"s": 28.78, "e": 29.26, "t": "kaget."}, {"s": 29.36, "e": 30.2, "t": "Plot twist:"}, {"s": 30.4, "e": 32.4, "t": "jadi bukan dilarang mandi,"}, {"s": 32.44, "e": 34.0, "t": "cukup istirahat dulu sepuluh"}, {"s": 34.08, "e": 35.12, "t": "sampai lima belas menit"}, {"s": 35.2, "e": 36.56, "t": "sampai napas normal,"}, {"s": 36.72, "e": 37.28, "t": "baru mandi."}, {"s": 37.46, "e": 38.74, "t": "Kamu tim langsung mandi"}, {"s": 38.9, "e": 40.1, "t": "atau tim nunggu kering?"}, {"s": 40.12, "e": 41.16, "t": "Tulis di komentar,"}, {"s": 41.24, "e": 42.333, "t": "dan subscribe biar nggak"}, {"s": 42.36, "e": 43.16, "t": "ketinggalan!"}]