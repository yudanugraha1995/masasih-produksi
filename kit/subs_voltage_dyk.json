[{"s": 0, "e": 0.846, "t": "What if your charger"}, {"s": 0.846, "e": 2.576, "t": "didn't fit the wall?"}, {"s": 2.576, "e": 3.515, "t": "Let's travel with a"}, {"s": 3.515, "e": 4.691, "t": "plug."}, {"s": 4.691, "e": 5.501, "t": "Canada:"}, {"s": 5.501, "e": 6.696, "t": "one hundred twenty volts,"}, {"s": 6.696, "e": 7.507, "t": "with a flat two"}, {"s": 7.507, "e": 8.901, "t": "pin plug."}, {"s": 8.901, "e": 9.797, "t": "The UK:"}, {"s": 9.797, "e": 11.034, "t": "two hundred thirty volts,"}, {"s": 11.034, "e": 11.93, "t": "and a chunky three"}, {"s": 11.93, "e": 12.826, "t": "pin plug with a"}, {"s": 12.826, "e": 14.472, "t": "fuse inside!"}, {"s": 14.472, "e": 15.539, "t": "Australia:"}, {"s": 15.539, "e": 16.733, "t": "two hundred thirty volts,"}, {"s": 16.733, "e": 18.65, "t": "with slanted pins."}, {"s": 18.65, "e": 19.461, "t": "Switzerland:"}, {"s": 19.461, "e": 20.783, "t": "two hundred thirty volts,"}, {"s": 20.783, "e": 21.765, "t": "and its own unique"}, {"s": 21.765, "e": 22.876, "t": "plug."}, {"s": 22.876, "e": 23.601, "t": "Japan:"}, {"s": 23.601, "e": 24.839, "t": "just one hundred volts,"}, {"s": 24.839, "e": 26.332, "t": "with two different frequencies,"}, {"s": 26.332, "e": 27.271, "t": "fifty in the east"}, {"s": 27.271, "e": 28.039, "t": "and sixty in the"}, {"s": 28.039, "e": 29.327, "t": "west!"}, {"s": 29.327, "e": 31.316, "t": "But here's the twist."}, {"s": 31.316, "e": 32.084, "t": "America:"}, {"s": 32.084, "e": 33.407, "t": "one hundred twenty volts,"}, {"s": 33.407, "e": 34.772, "t": "so electric kettles boil"}, {"s": 34.772, "e": 35.753, "t": "much slower,"}, {"s": 35.753, "e": 36.692, "t": "which is one reason"}, {"s": 36.692, "e": 38.015, "t": "many Americans heat water"}, {"s": 38.015, "e": 39.695, "t": "in the microwave!"}, {"s": 39.695, "e": 40.463, "t": "What plug do you"}, {"s": 40.463, "e": 41.787, "t": "use?"}, {"s": 41.787, "e": 42.768, "t": "Comment below,"}, {"s": 42.768, "e": 44.09, "t": "and subscribe for more!"}]