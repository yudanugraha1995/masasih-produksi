[{"s": 0.0, "e": 1.28, "t": "How many paid vacation"}, {"s": 1.44, "e": 2.16, "t": "days does the law"}, {"s": 2.24, "e": 2.72, "t": "give you?"}, {"s": 3.517, "e": 4.397, "t": "Brazil:"}, {"s": 4.437, "e": 5.357, "t": "thirty days,"}, {"s": 5.477, "e": 6.317, "t": "plus a bonus of"}, {"s": 6.397, "e": 7.197, "t": "one third of your"}, {"s": 7.277, "e": 8.077, "t": "salary."}, {"s": 8.855, "e": 9.815, "t": "The UK:"}, {"s": 9.895, "e": 10.695, "t": "twenty-eight,"}, {"s": 10.935, "e": 12.455, "t": "including bank holidays."}, {"s": 13.432, "e": 14.032, "t": "France:"}, {"s": 14.112, "e": 15.072, "t": "twenty-five,"}, {"s": 15.152, "e": 16.992, "t": "that's five full weeks."}, {"s": 17.71, "e": 18.35, "t": "Australia:"}, {"s": 18.43, "e": 19.63, "t": "twenty days."}, {"s": 20.607, "e": 21.207, "t": "Japan:"}, {"s": 21.327, "e": 22.087, "t": "just ten,"}, {"s": 22.207, "e": 23.127, "t": "and many workers don't"}, {"s": 23.207, "e": 24.247, "t": "even use them."}, {"s": 25.065, "e": 25.985, "t": "Plot twist:"}, {"s": 26.005, "e": 27.685, "t": "America gives zero."}, {"s": 28.462, "e": 29.902, "t": "No federal law guarantees"}, {"s": 29.982, "e": 31.102, "t": "a single paid day"}, {"s": 31.182, "e": 31.822, "t": "off!"}, {"s": 32.68, "e": 33.88, "t": "Comment your country!"}]