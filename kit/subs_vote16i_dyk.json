[{"s": 0, "e": 1.592, "t": "What if sixteen-year-olds could"}, {"s": 1.792, "e": 2.072, "t": "vote?"}, {"s": 2.722, "e": 3.522, "t": "In America,"}, {"s": 4.632, "e": 6.702, "t": "Australia and Japan,"}, {"s": 7.272, "e": 7.832, "t": "you have to wait"}, {"s": 7.912, "e": 9.521, "t": "until eighteen."}, {"s": 9.561, "e": 12.001, "t": "But in Austria,"}, {"s": 12.081, "e": 14.241, "t": "sixteen-year-olds already vote!"}, {"s": 14.801, "e": 15.921, "t": "And plot twist:"}, {"s": 16.521, "e": 17.561, "t": "the UK plans to"}, {"s": 17.641, "e": 18.681, "t": "lower its voting age"}, {"s": 18.761, "e": 20.121, "t": "to sixteen too."}, {"s": 20.561, "e": 22.05, "t": "Should teens vote?"}, {"s": 22.13, "e": 23.5, "t": "Comment below,"}, {"s": 23.54, "e": 25.02, "t": "and subscribe for more!"}]