[{"s": 0, "e": 1.187, "t": "Are French fries actually"}, {"s": 1.187, "e": 2.421, "t": "French?"}, {"s": 2.421, "e": 4.217, "t": "Let's ask around."}, {"s": 4.217, "e": 5.113, "t": "America:"}, {"s": 5.113, "e": 6.009, "t": "French fries,"}, {"s": 6.009, "e": 6.777, "t": "the side dish with"}, {"s": 6.777, "e": 8.627, "t": "almost every burger."}, {"s": 8.627, "e": 9.608, "t": "The UK:"}, {"s": 9.608, "e": 10.205, "t": "chips,"}, {"s": 10.205, "e": 11.059, "t": "and potato chips are"}, {"s": 11.059, "e": 12.125, "t": "called crisps,"}, {"s": 12.125, "e": 12.979, "t": "so fish and chips"}, {"s": 12.979, "e": 14.532, "t": "means fries!"}, {"s": 14.532, "e": 15.385, "t": "Australia:"}, {"s": 15.385, "e": 16.239, "t": "hot chips,"}, {"s": 16.239, "e": 16.964, "t": "to tell them apart"}, {"s": 16.964, "e": 17.433, "t": "from the ones in"}, {"s": 17.433, "e": 18.713, "t": "a bag."}, {"s": 18.713, "e": 19.737, "t": "Canada:"}, {"s": 19.737, "e": 20.633, "t": "poutine,"}, {"s": 20.633, "e": 21.87, "t": "fries with gravy and"}, {"s": 21.87, "e": 23.107, "t": "squeaky cheese curds,"}, {"s": 23.107, "e": 24.455, "t": "from Quebec."}, {"s": 24.455, "e": 25.649, "t": "The Netherlands:"}, {"s": 25.649, "e": 26.375, "t": "patat,"}, {"s": 26.375, "e": 27.185, "t": "often with a big"}, {"s": 27.185, "e": 28.124, "t": "scoop of mayo,"}, {"s": 28.124, "e": 28.935, "t": "or with peanut sauce"}, {"s": 28.935, "e": 29.831, "t": "and onions,"}, {"s": 29.831, "e": 31.765, "t": "called war fries!"}, {"s": 31.765, "e": 33.581, "t": "But here's the twist."}, {"s": 33.581, "e": 34.69, "t": "Belgium:"}, {"s": 34.69, "e": 35.799, "t": "Belgians say fries were"}, {"s": 35.799, "e": 36.823, "t": "invented there,"}, {"s": 36.823, "e": 37.89, "t": "not in France,"}, {"s": 37.89, "e": 38.487, "t": "and they even have"}, {"s": 38.487, "e": 39.554, "t": "a fries museum in"}, {"s": 39.554, "e": 40.875, "t": "Bruges!"}, {"s": 40.875, "e": 41.345, "t": "What do you call"}, {"s": 41.345, "e": 42.461, "t": "them?"}, {"s": 42.461, "e": 43.485, "t": "Comment below,"}, {"s": 43.485, "e": 44.807, "t": "and subscribe for more!"}]