[{"s": 0, "e": 0.675, "t": "What if there were"}, {"s": 0.675, "e": 1.913, "t": "more animals than people"}, {"s": 1.913, "e": 3.599, "t": "where you live?"}, {"s": 3.599, "e": 4.623, "t": "America:"}, {"s": 4.623, "e": 5.86, "t": "about eighty seven million"}, {"s": 5.86, "e": 6.415, "t": "cows,"}, {"s": 6.415, "e": 8.332, "t": "but way more people."}, {"s": 8.332, "e": 9.228, "t": "India:"}, {"s": 9.228, "e": 10.465, "t": "over one hundred ninety"}, {"s": 10.465, "e": 11.66, "t": "million cattle,"}, {"s": 11.66, "e": 12.812, "t": "but about one point"}, {"s": 12.812, "e": 14.829, "t": "four billion people."}, {"s": 14.829, "e": 15.811, "t": "The UK:"}, {"s": 15.811, "e": 17.005, "t": "around thirty one million"}, {"s": 17.005, "e": 17.688, "t": "sheep,"}, {"s": 17.688, "e": 18.797, "t": "about one for every"}, {"s": 18.797, "e": 20.217, "t": "two people."}, {"s": 20.217, "e": 21.071, "t": "Ireland:"}, {"s": 21.071, "e": 22.692, "t": "about seven million cattle,"}, {"s": 22.692, "e": 24.706, "t": "more cows than people!"}, {"s": 24.706, "e": 25.73, "t": "New Zealand:"}, {"s": 25.73, "e": 26.882, "t": "more than four sheep"}, {"s": 26.882, "e": 27.991, "t": "for every person,"}, {"s": 27.991, "e": 29.058, "t": "although that number used"}, {"s": 29.058, "e": 31.037, "t": "to be over twenty!"}, {"s": 31.037, "e": 32.835, "t": "Think that's wild?"}, {"s": 32.835, "e": 34.413, "t": "Here's the twist."}, {"s": 34.413, "e": 35.522, "t": "Australia:"}, {"s": 35.522, "e": 36.631, "t": "there are more kangaroos"}, {"s": 36.631, "e": 37.357, "t": "than people,"}, {"s": 37.357, "e": 38.466, "t": "with tens of millions"}, {"s": 38.466, "e": 39.49, "t": "hopping around a country"}, {"s": 39.49, "e": 41.689, "t": "of twenty seven million!"}, {"s": 41.689, "e": 42.713, "t": "What animal wins where"}, {"s": 42.713, "e": 44.145, "t": "you live?"}, {"s": 44.145, "e": 45.041, "t": "Comment below,"}, {"s": 45.041, "e": 46.491, "t": "and subscribe for more!"}]