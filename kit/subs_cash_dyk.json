[{"s": 0, "e": 2.386, "t": "What if cash disappeared?"}, {"s": 2.386, "e": 3.197, "t": "Let's see who still"}, {"s": 3.197, "e": 4.509, "t": "uses it."}, {"s": 4.509, "e": 5.447, "t": "Germany:"}, {"s": 5.447, "e": 6.727, "t": "still loves cash,"}, {"s": 6.727, "e": 7.751, "t": "and many small shops"}, {"s": 7.751, "e": 8.861, "t": "and bakeries don't take"}, {"s": 8.861, "e": 10.152, "t": "cards!"}, {"s": 10.152, "e": 11.048, "t": "Japan:"}, {"s": 11.048, "e": 11.944, "t": "still uses lots of"}, {"s": 11.944, "e": 12.883, "t": "cash too,"}, {"s": 12.883, "e": 13.779, "t": "though phone payments are"}, {"s": 13.779, "e": 15.364, "t": "growing fast."}, {"s": 15.364, "e": 16.345, "t": "America:"}, {"s": 16.345, "e": 17.369, "t": "most people pay by"}, {"s": 17.369, "e": 18.351, "t": "card now,"}, {"s": 18.351, "e": 19.631, "t": "but some cities require"}, {"s": 19.631, "e": 21.735, "t": "stores to accept cash."}, {"s": 21.735, "e": 22.845, "t": "Australia:"}, {"s": 22.845, "e": 23.783, "t": "cash is only about"}, {"s": 23.783, "e": 25.106, "t": "thirteen percent of in"}, {"s": 25.106, "e": 26.731, "t": "person payments."}, {"s": 26.731, "e": 27.67, "t": "The UK:"}, {"s": 27.67, "e": 29.491, "t": "around twelve percent."}, {"s": 29.491, "e": 31.289, "t": "But here's the twist."}, {"s": 31.289, "e": 32.099, "t": "Sweden:"}, {"s": 32.099, "e": 32.953, "t": "fewer than one in"}, {"s": 32.953, "e": 34.233, "t": "ten store purchases use"}, {"s": 34.233, "e": 35.086, "t": "cash,"}, {"s": 35.086, "e": 35.939, "t": "some shops won't take"}, {"s": 35.939, "e": 36.707, "t": "it at all,"}, {"s": 36.707, "e": 37.902, "t": "and almost everyone pays"}, {"s": 37.902, "e": 38.926, "t": "with an app called"}, {"s": 38.926, "e": 40.249, "t": "Swish!"}, {"s": 40.249, "e": 42.123, "t": "Cash or card?"}, {"s": 42.123, "e": 43.104, "t": "Comment below,"}, {"s": 43.104, "e": 44.341, "t": "and subscribe for more!"}]