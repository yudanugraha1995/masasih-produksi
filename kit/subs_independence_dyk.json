[{"s": 0, "e": 0.846, "t": "What if your country"}, {"s": 0.846, "e": 3.06, "t": "had no independence day?"}, {"s": 3.06, "e": 4.563, "t": "Let's check."}, {"s": 4.563, "e": 5.459, "t": "America:"}, {"s": 5.459, "e": 6.355, "t": "July fourth,"}, {"s": 6.355, "e": 7.805, "t": "seventeen seventy six,"}, {"s": 7.805, "e": 10.229, "t": "with fireworks and barbecues."}, {"s": 10.229, "e": 11.253, "t": "Mexico:"}, {"s": 11.253, "e": 12.49, "t": "September sixteenth,"}, {"s": 12.49, "e": 13.685, "t": "when people shout Viva"}, {"s": 13.685, "e": 15.769, "t": "Mexico the night before."}, {"s": 15.769, "e": 16.708, "t": "Canada:"}, {"s": 16.708, "e": 17.561, "t": "Canada Day,"}, {"s": 17.561, "e": 18.543, "t": "July first,"}, {"s": 18.543, "e": 20.036, "t": "for confederation in eighteen"}, {"s": 20.036, "e": 21.569, "t": "sixty seven."}, {"s": 21.569, "e": 22.337, "t": "India:"}, {"s": 22.337, "e": 23.531, "t": "August fifteenth,"}, {"s": 23.531, "e": 24.769, "t": "nineteen forty seven,"}, {"s": 24.769, "e": 27.124, "t": "with kites flying everywhere."}, {"s": 27.124, "e": 28.233, "t": "Australia:"}, {"s": 28.233, "e": 29.556, "t": "no independence day,"}, {"s": 29.556, "e": 31.22, "t": "Australia Day is January"}, {"s": 31.22, "e": 32.159, "t": "twenty sixth,"}, {"s": 32.159, "e": 32.927, "t": "when the First Fleet"}, {"s": 32.927, "e": 34.265, "t": "arrived."}, {"s": 34.265, "e": 35.948, "t": "But here's the twist."}, {"s": 35.948, "e": 37.015, "t": "The UK:"}, {"s": 37.015, "e": 38.551, "t": "no independence day either,"}, {"s": 38.551, "e": 39.489, "t": "and more than sixty"}, {"s": 39.489, "e": 41.239, "t": "countries celebrate independence from"}, {"s": 41.239, "e": 42.331, "t": "it!"}, {"s": 42.331, "e": 43.142, "t": "Does your country have"}, {"s": 43.142, "e": 44.293, "t": "one?"}, {"s": 44.293, "e": 45.317, "t": "Comment below,"}, {"s": 45.317, "e": 46.639, "t": "and subscribe for more!"}]