[{"s": 0, "e": 1.102, "t": "Which country has the"}, {"s": 1.102, "e": 3.06, "t": "most time zones?"}, {"s": 3.06, "e": 4.55, "t": "Let's count."}, {"s": 4.55, "e": 5.361, "t": "China:"}, {"s": 5.361, "e": 6.427, "t": "just one time zone"}, {"s": 6.427, "e": 7.665, "t": "for the whole country,"}, {"s": 7.665, "e": 8.39, "t": "so in the far"}, {"s": 8.39, "e": 9.286, "t": "west the sun can"}, {"s": 9.286, "e": 11.429, "t": "rise after ten AM!"}, {"s": 11.429, "e": 12.325, "t": "India:"}, {"s": 12.325, "e": 13.52, "t": "one time zone too,"}, {"s": 13.52, "e": 14.16, "t": "and it's half an"}, {"s": 14.16, "e": 15.056, "t": "hour off from most"}, {"s": 15.056, "e": 16.469, "t": "of the world."}, {"s": 16.469, "e": 17.535, "t": "Australia:"}, {"s": 17.535, "e": 18.986, "t": "three main time zones,"}, {"s": 18.986, "e": 20.138, "t": "plus a few unusual"}, {"s": 20.138, "e": 21.418, "t": "ones."}, {"s": 21.418, "e": 22.229, "t": "America:"}, {"s": 22.229, "e": 23.338, "t": "six time zones across"}, {"s": 23.338, "e": 24.533, "t": "its fifty states,"}, {"s": 24.533, "e": 25.557, "t": "from Hawaii to the"}, {"s": 25.557, "e": 27.115, "t": "East Coast."}, {"s": 27.115, "e": 27.797, "t": "Russia:"}, {"s": 27.797, "e": 28.949, "t": "eleven time zones,"}, {"s": 28.949, "e": 29.888, "t": "from Europe all the"}, {"s": 29.888, "e": 31.549, "t": "way to the Pacific!"}, {"s": 31.549, "e": 33.286, "t": "Think that's the most?"}, {"s": 33.286, "e": 34.934, "t": "Here's the twist."}, {"s": 34.934, "e": 35.659, "t": "France:"}, {"s": 35.659, "e": 36.811, "t": "twelve time zones,"}, {"s": 36.811, "e": 37.707, "t": "thanks to its islands"}, {"s": 37.707, "e": 38.945, "t": "and territories all over"}, {"s": 38.945, "e": 40.319, "t": "the world!"}, {"s": 40.319, "e": 41.002, "t": "How many does your"}, {"s": 41.002, "e": 42.509, "t": "country have?"}, {"s": 42.509, "e": 43.448, "t": "Comment below,"}, {"s": 43.448, "e": 44.685, "t": "and subscribe for more!"}]