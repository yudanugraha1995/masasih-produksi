[{"s": 0.08, "e": 1.274, "t": "Katanya kalau cegukan,"}, {"s": 1.394, "e": 3.034, "t": "harus dikagetin biar berhenti?"}, {"s": 3.234, "e": 4.114, "t": "Masa sih?"}, {"s": 4.354, "e": 6.194, "t": "Cegukan itu otot diafragma"}, {"s": 6.314, "e": 7.354, "t": "kejang tiba-tiba."}, {"s": 7.554, "e": 9.714, "t": "Dikagetin belum terbukti ampuh."}, {"s": 9.794, "e": 10.914, "t": "Yang sering dicoba:"}, {"s": 10.954, "e": 12.114, "t": "tahan napas sebentar,"}, {"s": 12.274, "e": 13.314, "t": "atau minum air dingin"}, {"s": 13.354, "e": 14.274, "t": "pelan-pelan."}, {"s": 14.548, "e": 15.314, "t": "Plot twist:"}, {"s": 15.474, "e": 16.514, "t": "ada orang Amerika yang"}, {"s": 16.594, "e": 19.314, "t": "cegukan sampai 68 tahun!"}, {"s": 19.354, "e": 20.754, "t": "Kamu biasanya ngatasin cegukan"}, {"s": 20.834, "e": 21.874, "t": "pakai cara apa?"}, {"s": 21.914, "e": 22.914, "t": "Jawab di komentar,"}, {"s": 22.994, "e": 24.034, "t": "dan subscribe ya!"}]