[{"s": 0.0, "e": 0.96, "t": "Can you get fined"}, {"s": 1.04, "e": 2.08, "t": "for not voting?"}, {"s": 2.671, "e": 3.471, "t": "Belgium:"}, {"s": 3.671, "e": 4.111, "t": "yes,"}, {"s": 4.191, "e": 5.631, "t": "voting is mandatory."}, {"s": 6.002, "e": 6.962, "t": "Luxembourg:"}, {"s": 7.042, "e": 7.762, "t": "mandatory."}, {"s": 8.353, "e": 9.233, "t": "Brazil:"}, {"s": 9.313, "e": 10.113, "t": "mandatory,"}, {"s": 10.193, "e": 11.313, "t": "with a small fine."}, {"s": 11.824, "e": 12.784, "t": "Argentina:"}, {"s": 12.864, "e": 13.584, "t": "mandatory."}, {"s": 14.175, "e": 14.895, "t": "Peru:"}, {"s": 14.975, "e": 16.135, "t": "mandatory too."}, {"s": 16.685, "e": 17.565, "t": "Singapore:"}, {"s": 17.685, "e": 18.365, "t": "skip it and you're"}, {"s": 18.645, "e": 19.485, "t": "removed from the voter"}, {"s": 19.565, "e": 19.965, "t": "roll."}, {"s": 20.476, "e": 21.356, "t": "America:"}, {"s": 21.476, "e": 22.196, "t": "voluntary."}, {"s": 22.667, "e": 23.547, "t": "The UK:"}, {"s": 23.627, "e": 24.427, "t": "voluntary."}, {"s": 24.938, "e": 25.898, "t": "Plot twist:"}, {"s": 26.178, "e": 27.418, "t": "Australia has made everyone"}, {"s": 27.578, "e": 29.498, "t": "vote since 1924."}, {"s": 29.969, "e": 30.569, "t": "Skip it and you"}, {"s": 30.649, "e": 31.449, "t": "pay a twenty dollar"}, {"s": 31.609, "e": 32.249, "t": "fine!"}, {"s": 32.76, "e": 33.88, "t": "Comment your country!"}]