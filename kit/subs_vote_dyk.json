[{"s": 0.0, "e": 0.96, "t": "Can you get fined"}, {"s": 1.04, "e": 1.92, "t": "for not voting?"}, {"s": 2.8, "e": 3.68, "t": "Belgium:"}, {"s": 3.88, "e": 4.32, "t": "yes,"}, {"s": 4.4, "e": 5.68, "t": "voting has been mandatory"}, {"s": 5.84, "e": 7.52, "t": "since 1893."}, {"s": 8.54, "e": 9.18, "t": "Brazil:"}, {"s": 9.2, "e": 9.68, "t": "mandatory,"}, {"s": 9.72, "e": 11.04, "t": "with a small fine."}, {"s": 11.9, "e": 12.78, "t": "Singapore:"}, {"s": 12.86, "e": 13.74, "t": "skip it and you're"}, {"s": 13.98, "e": 14.86, "t": "removed from the voter"}, {"s": 14.94, "e": 15.5, "t": "roll."}, {"s": 16.56, "e": 17.24, "t": "America:"}, {"s": 17.32, "e": 18.04, "t": "voluntary,"}, {"s": 18.12, "e": 19.64, "t": "and millions skip it."}, {"s": 20.5, "e": 21.46, "t": "The UK:"}, {"s": 21.54, "e": 22.82, "t": "voluntary too."}, {"s": 23.72, "e": 24.64, "t": "Plot twist:"}, {"s": 24.92, "e": 26.16, "t": "Australia has made everyone"}, {"s": 26.24, "e": 28.4, "t": "vote since 1924."}, {"s": 29.3, "e": 29.98, "t": "Skip it and you"}, {"s": 30.06, "e": 30.94, "t": "pay a twenty dollar"}, {"s": 31.1, "e": 31.82, "t": "fine!"}, {"s": 32.76, "e": 33.88, "t": "Comment your country!"}]