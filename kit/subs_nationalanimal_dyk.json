[{"s": 0, "e": 1.059, "t": "What if your national"}, {"s": 1.059, "e": 3.111, "t": "animal was a unicorn?"}, {"s": 3.111, "e": 4.503, "t": "Let's check."}, {"s": 4.503, "e": 5.527, "t": "Australia:"}, {"s": 5.527, "e": 6.594, "t": "the kangaroo,"}, {"s": 6.594, "e": 7.149, "t": "right on the coat"}, {"s": 7.149, "e": 7.917, "t": "of arms next to"}, {"s": 7.917, "e": 9.307, "t": "the emu."}, {"s": 9.307, "e": 10.032, "t": "Canada:"}, {"s": 10.032, "e": 10.8, "t": "the beaver,"}, {"s": 10.8, "e": 11.483, "t": "which is even on"}, {"s": 11.483, "e": 13.619, "t": "the five cent coin!"}, {"s": 13.619, "e": 14.515, "t": "New Zealand:"}, {"s": 14.515, "e": 15.326, "t": "the kiwi,"}, {"s": 15.326, "e": 16.222, "t": "a bird that can't"}, {"s": 16.222, "e": 16.819, "t": "fly,"}, {"s": 16.819, "e": 17.801, "t": "and New Zealanders call"}, {"s": 17.801, "e": 20.014, "t": "themselves Kiwis too."}, {"s": 20.014, "e": 20.825, "t": "India:"}, {"s": 20.825, "e": 22.062, "t": "the Bengal tiger,"}, {"s": 22.062, "e": 23.214, "t": "with about three quarters"}, {"s": 23.214, "e": 24.11, "t": "of the world's wild"}, {"s": 24.11, "e": 25.409, "t": "tigers."}, {"s": 25.409, "e": 26.732, "t": "The UK:"}, {"s": 26.732, "e": 28.353, "t": "Scotland's national animal is"}, {"s": 28.353, "e": 29.915, "t": "the unicorn!"}, {"s": 29.915, "e": 31.699, "t": "But here's the twist."}, {"s": 31.699, "e": 32.681, "t": "America:"}, {"s": 32.681, "e": 33.79, "t": "the bald eagle has"}, {"s": 33.79, "e": 34.601, "t": "been on the Great"}, {"s": 34.601, "e": 35.966, "t": "Seal since seventeen eighty"}, {"s": 35.966, "e": 36.606, "t": "two,"}, {"s": 36.606, "e": 37.801, "t": "but it only officially"}, {"s": 37.801, "e": 39.123, "t": "became the national bird"}, {"s": 39.123, "e": 40.361, "t": "in December twenty twenty"}, {"s": 40.361, "e": 41.572, "t": "four!"}, {"s": 41.572, "e": 43.726, "t": "What's your national animal?"}, {"s": 43.726, "e": 44.579, "t": "Comment below,"}, {"s": 44.579, "e": 45.859, "t": "and subscribe for more!"}]