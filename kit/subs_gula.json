[{"s": 0.304, "e": 0.56, "t": "Woyyy!"}, {"s": 0.62, "e": 1.68, "t": "Habis makan permen,"}, {"s": 1.728, "e": 3.4, "t": "anak-anak langsung lari-larian nggak"}, {"s": 3.424, "e": 3.92, "t": "bisa diam!"}, {"s": 4.888, "e": 5.76, "t": "Masa sih gula bikin"}, {"s": 5.8, "e": 6.48, "t": "hiperaktif?"}, {"s": 7.025, "e": 7.68, "t": "Yuk kita cek!"}, {"s": 7.856, "e": 9.6, "t": "Para peneliti sudah menguji"}, {"s": 9.66, "e": 10.92, "t": "ini berkali-kali."}, {"s": 11.01, "e": 12.24, "t": "Ada analisis besar di"}, {"s": 12.32, "e": 15.2, "t": "jurnal JAMA tahun 1995"}, {"s": 15.248, "e": 16.56, "t": "yang menggabungkan enam belas"}, {"s": 16.6, "e": 17.6, "t": "penelitian."}, {"s": 17.76, "e": 18.88, "t": "Hasilnya,"}, {"s": 18.96, "e": 20.16, "t": "gula nggak terbukti mengubah"}, {"s": 20.213, "e": 22.24, "t": "perilaku atau konsentrasi anak."}, {"s": 22.42, "e": 24.24, "t": "Ada juga penelitian unik."}, {"s": 24.34, "e": 25.76, "t": "Semua anak diberi minuman"}, {"s": 25.8, "e": 26.72, "t": "tanpa gula,"}, {"s": 26.784, "e": 28.24, "t": "tapi sebagian ibu diberitahu"}, {"s": 28.32, "e": 30.0, "t": "anaknya baru minum gula."}, {"s": 30.28, "e": 31.92, "t": "Ibu-ibu itu menilai anaknya"}, {"s": 32.0, "e": 33.36, "t": "jadi lebih hiperaktif,"}, {"s": 33.4, "e": 34.4, "t": "padahal nggak ada gula"}, {"s": 34.464, "e": 35.44, "t": "sama sekali."}, {"s": 36.122, "e": 36.96, "t": "Plot twist-nya..."}, {"s": 36.976, "e": 38.48, "t": "yang berubah bukan anaknya,"}, {"s": 38.544, "e": 39.68, "t": "tapi cara orang dewasa"}, {"s": 39.72, "e": 40.4, "t": "melihatnya!"}, {"s": 40.62, "e": 42.0, "t": "Lagi pula,"}, {"s": 42.04, "e": 43.12, "t": "permen biasanya ada di"}, {"s": 43.16, "e": 44.8, "t": "pesta dan acara ramai,"}, {"s": 44.84, "e": 46.0, "t": "wajar kalau anak jadi"}, {"s": 46.08, "e": 46.72, "t": "heboh."}, {"s": 47.0, "e": 48.32, "t": "Tapi gula tetap perlu"}, {"s": 48.38, "e": 49.28, "t": "dibatasi,"}, {"s": 49.326, "e": 50.4, "t": "karena bisa bikin gigi"}, {"s": 50.44, "e": 51.68, "t": "berlubang dan berat badan"}, {"s": 51.733, "e": 52.24, "t": "naik."}, {"s": 52.52, "e": 54.08, "t": "Ganti camilan manis dengan"}, {"s": 54.16, "e": 54.72, "t": "buah,"}, {"s": 54.74, "e": 56.0, "t": "dan biasakan minum air"}, {"s": 56.04, "e": 57.2, "t": "putih."}, {"s": 57.336, "e": 58.24, "t": "Kamu tim permen atau"}, {"s": 58.3, "e": 58.96, "t": "tim cokelat,"}, {"s": 59.0, "e": 59.6, "t": "kak?"}, {"s": 59.64, "e": 61.04, "t": "Tulis di komentar ya!"}]