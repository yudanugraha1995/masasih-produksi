[{"s": 0.072, "e": 0.56, "t": "Woyyy!"}, {"s": 0.64, "e": 2.0, "t": "Jangan telan permen karet,"}, {"s": 2.04, "e": 3.2, "t": "nanti nempel di usus"}, {"s": 3.253, "e": 4.08, "t": "tujuh tahun!"}, {"s": 4.71, "e": 5.36, "t": "Masa sih?"}, {"s": 5.905, "e": 6.56, "t": "Yuk kita cek!"}, {"s": 6.74, "e": 8.24, "t": "Permen karet memang beda"}, {"s": 8.288, "e": 9.52, "t": "dari makanan lain."}, {"s": 9.56, "e": 10.48, "t": "Bagian karetnya,"}, {"s": 10.512, "e": 11.92, "t": "yang disebut gum base,"}, {"s": 11.973, "e": 13.04, "t": "nggak bisa dicerna oleh"}, {"s": 13.093, "e": 14.4, "t": "enzim di perut."}, {"s": 14.44, "e": 15.52, "t": "Tapi nggak dicerna bukan"}, {"s": 15.56, "e": 16.8, "t": "berarti nempel."}, {"s": 16.853, "e": 18.0, "t": "Usus kita terus bergerak"}, {"s": 18.04, "e": 19.2, "t": "mendorong isinya,"}, {"s": 19.24, "e": 21.12, "t": "gerakan ini disebut peristaltik."}, {"s": 21.48, "e": 22.88, "t": "Jadi permen karet yang"}, {"s": 22.92, "e": 24.4, "t": "ketelan ikut terdorong,"}, {"s": 24.46, "e": 25.92, "t": "dan biasanya keluar bersama"}, {"s": 25.96, "e": 27.76, "t": "kotoran dalam beberapa hari."}, {"s": 27.92, "e": 29.28, "t": "Ada laporan dokter di"}, {"s": 29.32, "e": 32.72, "t": "jurnal Pediatrics tahun 1998"}, {"s": 32.77, "e": 34.48, "t": "tentang anak-anak yang ususnya"}, {"s": 34.528, "e": 35.28, "t": "tersumbat."}, {"s": 35.52, "e": 37.2, "t": "Ternyata mereka menelan permen"}, {"s": 37.24, "e": 38.56, "t": "karet banyak sekali setiap"}, {"s": 38.624, "e": 39.28, "t": "hari,"}, {"s": 39.32, "e": 40.4, "t": "kadang bareng benda lain"}, {"s": 40.45, "e": 41.52, "t": "seperti koin."}, {"s": 42.106, "e": 42.97, "t": "Plot twist-nya..."}, {"s": 43.002, "e": 44.09, "t": "yang bahaya bukan satu"}, {"s": 44.13, "e": 45.05, "t": "permen karet yang nggak"}, {"s": 45.09, "e": 46.33, "t": "sengaja ketelan,"}, {"s": 46.378, "e": 47.93, "t": "tapi kebiasaan menelan banyak"}, {"s": 47.95, "e": 49.37, "t": "permen karet terus-terusan!"}, {"s": 49.663, "e": 51.85, "t": "Apalagi untuk anak kecil."}, {"s": 51.89, "e": 52.97, "t": "Jadi kalau nggak sengaja"}, {"s": 53.01, "e": 54.09, "t": "ketelan satu,"}, {"s": 54.138, "e": 55.05, "t": "santai aja."}, {"s": 55.09, "e": 56.41, "t": "Tapi biasakan buang permen"}, {"s": 56.49, "e": 57.93, "t": "karet ke tempat sampah,"}, {"s": 57.97, "e": 58.97, "t": "dan jangan kasih permen"}, {"s": 59.05, "e": 60.01, "t": "karet ke anak yang"}, {"s": 60.05, "e": 62.25, "t": "belum ngerti cara mengunyahnya."}, {"s": 62.46, "e": 63.29, "t": "Kamu tim pernah nelan"}, {"s": 63.33, "e": 64.41, "t": "permen karet atau tim"}, {"s": 64.45, "e": 65.45, "t": "selalu dibuang,"}, {"s": 65.49, "e": 66.01, "t": "kak?"}, {"s": 66.07, "e": 67.29, "t": "Tulis di komentar ya!"}]