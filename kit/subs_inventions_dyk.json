[{"s": 0, "e": 0.803, "t": "What if you knew"}, {"s": 0.803, "e": 1.785, "t": "who invented the stuff"}, {"s": 1.785, "e": 3.695, "t": "you use every day?"}, {"s": 3.695, "e": 5.029, "t": "Let's look."}, {"s": 5.029, "e": 6.011, "t": "Australia:"}, {"s": 6.011, "e": 7.333, "t": "helped invent WiFi,"}, {"s": 7.333, "e": 8.4, "t": "Google Maps and the"}, {"s": 8.4, "e": 10.407, "t": "black box flight recorder!"}, {"s": 10.407, "e": 11.218, "t": "Japan:"}, {"s": 11.218, "e": 12.157, "t": "instant noodles,"}, {"s": 12.157, "e": 13.437, "t": "in nineteen fifty eight,"}, {"s": 13.437, "e": 15.345, "t": "and karaoke too."}, {"s": 15.345, "e": 16.028, "t": "Sweden:"}, {"s": 16.028, "e": 16.924, "t": "the three point seat"}, {"s": 16.924, "e": 17.393, "t": "belt,"}, {"s": 17.393, "e": 18.289, "t": "by Volvo,"}, {"s": 18.289, "e": 19.228, "t": "which gave the design"}, {"s": 19.228, "e": 19.911, "t": "away for free to"}, {"s": 19.911, "e": 21.443, "t": "save lives."}, {"s": 21.443, "e": 22.168, "t": "Canada:"}, {"s": 22.168, "e": 22.979, "t": "insulin,"}, {"s": 22.979, "e": 23.789, "t": "first used to treat"}, {"s": 23.789, "e": 25.197, "t": "diabetes in nineteen twenty"}, {"s": 25.197, "e": 26.295, "t": "two."}, {"s": 26.295, "e": 27.234, "t": "The UK:"}, {"s": 27.234, "e": 28.514, "t": "the World Wide Web,"}, {"s": 28.514, "e": 29.751, "t": "by Tim Berners Lee"}, {"s": 29.751, "e": 31.655, "t": "in nineteen eighty nine."}, {"s": 31.655, "e": 33.348, "t": "But here's the twist."}, {"s": 33.348, "e": 34.372, "t": "America:"}, {"s": 34.372, "e": 35.353, "t": "the airplane,"}, {"s": 35.353, "e": 36.548, "t": "the first computer network"}, {"s": 36.548, "e": 37.828, "t": "that became the internet,"}, {"s": 37.828, "e": 38.724, "t": "and the smartphone as"}, {"s": 38.724, "e": 39.577, "t": "we know it,"}, {"s": 39.577, "e": 41.365, "t": "all started there!"}, {"s": 41.365, "e": 42.432, "t": "Which invention can't you"}, {"s": 42.432, "e": 43.811, "t": "live without?"}, {"s": 43.8