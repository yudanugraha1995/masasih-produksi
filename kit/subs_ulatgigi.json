[{"s": 0.144, "e": 0.92, "t": "Woyyy!"}, {"s": 1.02, "e": 3.04, "t": "Gigi bolong dan cenat-cenut,"}, {"s": 3.08, "e": 4.321, "t": "katanya ada ulatnya!"}, {"s": 5.27, "e": 6.0, "t": "Masa sih?"}, {"s": 6.526, "e": 7.286, "t": "Yuk kita cek!"}, {"s": 7.546, "e": 9.206, "t": "Mitos ulat gigi itu"}, {"s": 9.266, "e": 10.246, "t": "tua banget,"}, {"s": 10.286, "e": 11.366, "t": "sudah ada sejak zaman"}, {"s": 11.446, "e": 13.206, "t": "Babilonia ribuan tahun lalu."}, {"s": 13.499, "e": 15.446, "t": "Orang dulu mengira ada"}, {"s": 15.486, "e": 16.886, "t": "cacing kecil yang menggerogoti"}, {"s": 16.946, "e": 17.526, "t": "gigi."}, {"s": 17.846, "e": 19.046, "t": "Faktanya,"}, {"s": 19.099, "e": 20.166, "t": "ulat gigi itu nggak"}, {"s": 20.226, "e": 20.646, "t": "ada."}, {"s": 20.766, "e": 22.566, "t": "Pelakunya bakteri di mulut."}, {"s": 22.726, "e": 24.326, "t": "Bakteri ini makan sisa"}, {"s": 24.366, "e": 25.606, "t": "gula dan karbohidrat yang"}, {"s": 25.646, "e": 26.806, "t": "nempel di gigi,"}, {"s": 26.886, "e": 28.486, "t": "lalu menghasilkan asam."}, {"s": 28.673, "e": 30.166, "t": "Asam inilah yang pelan-pelan"}, {"s": 30.206, "e": 31.766, "t": "melarutkan lapisan email,"}, {"s": 31.814, "e": 33.606, "t": "sampai gigi jadi berlubang."}, {"s": 33.766, "e": 34.966, "t": "Makanya,"}, {"s": 35.006, "e": 36.486, "t": "makin sering ngemil manis,"}, {"s": 36.539, "e": 37.686, "t": "makin sering gigi diserang"}, {"s": 37.766, "e": 38.326, "t": "asam."}, {"s": 39.094, "e": 40.046, "t": "Plot twist-nya..."}, {"s": 40.086, "e": 41.126, "t": "yang bikin gigi bolong"}, {"s": 41.179, "e": 42.006, "t": "bukan ulat,"}, {"s": 42.07, "e": 43.686, "t": "tapi kebiasaan kita sendiri!"}, {"s": 44.086, "e": 45.286, "t": "Jadi kalau ada yang"}, {"s": 45.313, "e": 46.566, "t": "ngaku bisa ngeluarin ulat"}, {"s": 46.598, "e": 47.846, "t": "dari gigi kamu,"}, {"s": 47.886, "e": 49.286, "t": "jangan langsung percaya."}, {"s": 49.414, "e": 51.046, "t": "Cara mencegahnya,"}, {"s": 51.086, "e": 52.006, "t": "sikat gigi dua kali"}, {"s": 52.059, "e": 53.286, "t": "sehari pakai pasta gigi"}, {"s": 53.346, "e": 54.246, "t": "berfluoride,"}, {"s": 54.286, "e": 55.686, "t": "kurangi ngemil manis,"}, {"s": 55.726, "e": 56.566, "t": "dan periksa ke dokter"}, {"s": 56.626, "e": 58.086, "t": "gigi tiap enam bulan."}, {"s": 59.321, "e": 60.166, "t": "Kamu tim sikat gigi"}, {"s": 60.193, "e": 61.366, "t": "sebelum tidur atau tim"}, {"s": 61.393, "e": 62.006, "t": "suka lupa,"}, {"s": 62.046, "e": 62.246, "t": "kak?"}, {"s": 62.366, "e": 63.686, "t": "Tulis di komentar ya!"}]