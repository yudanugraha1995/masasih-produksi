[{"s": 0, "e": 0.675, "t": "What if you said"}, {"s": 0.675, "e": 2.651, "t": "hello with your nose?"}, {"s": 2.651, "e": 4.369, "t": "Let's travel."}, {"s": 4.369, "e": 5.137, "t": "America:"}, {"s": 5.137, "e": 6.46, "t": "a firm handshake,"}, {"s": 6.46, "e": 7.185, "t": "and a weak one"}, {"s": 7.185, "e": 8.816, "t": "can look rude!"}, {"s": 8.816, "e": 9.84, "t": "Australia:"}, {"s": 9.84, "e": 10.736, "t": "a handshake and a"}, {"s": 10.736, "e": 11.461, "t": "friendly g'day,"}, {"s": 11.461, "e": 12.643, "t": "mate!"}, {"s": 12.643, "e": 13.496, "t": "Japan:"}, {"s": 13.496, "e": 14.264, "t": "a bow,"}, {"s": 14.264, "e": 14.947, "t": "and the deeper the"}, {"s": 14.947, "e": 15.416, "t": "bow,"}, {"s": 15.416, "e": 16.44, "t": "the more respect you"}, {"s": 16.44, "e": 17.534, "t": "show."}, {"s": 17.534, "e": 18.43, "t": "France:"}, {"s": 18.43, "e": 19.283, "t": "la bise,"}, {"s": 19.283, "e": 20.051, "t": "a kiss on each"}, {"s": 20.051, "e": 20.649, "t": "cheek,"}, {"s": 20.649, "e": 21.715, "t": "and some regions do"}, {"s": 21.715, "e": 23.803, "t": "three or even four!"}, {"s": 23.803, "e": 24.656, "t": "India:"}, {"s": 24.656, "e": 25.68, "t": "namaste,"}, {"s": 25.68, "e": 26.747, "t": "palms pressed together with"}, {"s": 26.747, "e": 27.856, "t": "a small bow,"}, {"s": 27.856, "e": 29.597, "t": "no touching needed."}, {"s": 29.597, "e": 31.832, "t": "But here's the twist."}, {"s": 31.832, "e": 32.899, "t": "New Zealand:"}, {"s": 32.899, "e": 34.307, "t": "the Māori hongi,"}, {"s": 34.307, "e": 35.672, "t": "pressing noses and foreheads"}, {"s": 35.672, "e": 36.696, "t": "together to share the"}, {"s": 36.696, "e": 38.402, "t": "breath of life!"}, {"s": 38.402, "e": 38.999, "t": "How do you say"}, {"s": 38.999, "e": 40.389, "t": "hello?"}, {"s": 40.389, "e": 41.327, "t": "Comment below,"}, {"s": 41.327, "e": 42.564, "t": "and subscribe for more!"}]