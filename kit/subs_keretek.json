[{"s": 0.072, "e": 0.64, "t": "Woyyy!"}, {"s": 0.72, "e": 2.24, "t": "Jangan keretekin jari,"}, {"s": 2.32, "e": 3.44, "t": "nanti kena radang sendi!"}, {"s": 4.07, "e": 4.88, "t": "Masa sih?"}, {"s": 5.146, "e": 5.766, "t": "Yuk kita cek!"}, {"s": 5.986, "e": 7.606, "t": "Bunyi krek itu datang"}, {"s": 7.654, "e": 8.806, "t": "dari cairan pelumas di"}, {"s": 8.846, "e": 9.526, "t": "dalam sendi."}, {"s": 9.739, "e": 11.286, "t": "Saat sendi ditarik,"}, {"s": 11.313, "e": 12.806, "t": "tekanannya turun dan terbentuk"}, {"s": 12.838, "e": 13.926, "t": "gelembung gas."}, {"s": 14.006, "e": 15.206, "t": "Gelembung inilah yang bikin"}, {"s": 15.286, "e": 15.686, "t": "bunyi."}, {"s": 15.946, "e": 17.686, "t": "Ada dokter di Amerika"}, {"s": 17.734, "e": 19.046, "t": "bernama Donald Unger yang"}, {"s": 19.086, "e": 20.006, "t": "penasaran."}, {"s": 20.126, "e": 21.446, "t": "Selama lebih dari enam"}, {"s": 21.486, "e": 22.326, "t": "puluh tahun,"}, {"s": 22.386, "e": 23.686, "t": "dia cuma mengeretekkan jari"}, {"s": 23.726, "e": 24.486, "t": "tangan kiri,"}, {"s": 24.526, "e": 25.846, "t": "tangan kanannya nggak."}, {"s": 25.966, "e": 26.926, "t": "Hasilnya?"}, {"s": 27.026, "e": 28.806, "t": "Dua tangannya sama-sama sehat,"}, {"s": 28.859, "e": 30.246, "t": "nggak ada radang sendi."}, {"s": 30.346, "e": 32.006, "t": "Penelitian ini bahkan dapat"}, {"s": 32.038, "e": 33.686, "t": "penghargaan Ig Nobel."}, {"s": 33.806, "e": 35.366, "t": "Penelitian lain ke ratusan"}, {"s": 35.419, "e": 36.646, "t": "orang juga nggak menemukan"}, {"s": 36.686, "e": 38.406, "t": "hubungan antara kebiasaan ini"}, {"s": 38.446, "e": 39.606, "t": "dan radang sendi."}, {"s": 40.14, "e": 41.126, "t": "Plot twist-nya..."}, {"s": 41.158, "e": 42.406, "t": "yang perlu diwaspadai bukan"}, {"s": 42.466, "e": 43.366, "t": "bunyinya,"}, {"s": 43.446, "e": 44.566, "t": "tapi kalau bunyi itu"}, {"s": 44.606, "e": 46.166, "t": "disertai nyeri atau bengkak!"}, {"s": 46.353, "e": 47.766, "t": "Itu tanda a