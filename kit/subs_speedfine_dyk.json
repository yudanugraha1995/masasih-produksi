[{"s": 0, "e": 0.931, "t": "What if your speeding"}, {"s": 0.931, "e": 2.126, "t": "ticket depended on how"}, {"s": 2.126, "e": 3.893, "t": "much you earn?"}, {"s": 3.893, "e": 4.703, "t": "America:"}, {"s": 4.703, "e": 6.111, "t": "usually a flat fine,"}, {"s": 6.111, "e": 7.391, "t": "the same for everyone,"}, {"s": 7.391, "e": 9.153, "t": "set by each state."}, {"s": 9.153, "e": 9.921, "t": "Australia:"}, {"s": 9.921, "e": 11.243, "t": "a flat fine too,"}, {"s": 11.243, "e": 12.225, "t": "plus demerit points on"}, {"s": 12.225, "e": 13.722, "t": "your license."}, {"s": 13.722, "e": 14.789, "t": "The UK:"}, {"s": 14.789, "e": 15.898, "t": "courts can set fines"}, {"s": 15.898, "e": 16.709, "t": "based on your weekly"}, {"s": 16.709, "e": 17.993, "t": "income."}, {"s": 17.993, "e": 18.846, "t": "Germany:"}, {"s": 18.846, "e": 19.614, "t": "day fines,"}, {"s": 19.614, "e": 20.595, "t": "based on income,"}, {"s": 20.595, "e": 22.663, "t": "for serious offenses."}, {"s": 22.663, "e": 23.516, "t": "Switzerland:"}, {"s": 23.516, "e": 24.54, "t": "income based,"}, {"s": 24.54, "e": 25.436, "t": "and one driver got"}, {"s": 25.436, "e": 26.289, "t": "a fine of over"}, {"s": 26.289, "e": 28.655, "t": "one hundred thousand dollars!"}, {"s": 28.655, "e": 30.483, "t": "But here's the twist."}, {"s": 30.483, "e": 31.293, "t": "Finland:"}, {"s": 31.293, "e": 32.275, "t": "one millionaire got a"}, {"s": 32.275, "e": 33.213, "t": "speeding ticket of one"}, {"s": 33.213, "e": 34.408, "t": "hundred twenty one thousand"}, {"s": 34.408, "e": 35.133, "t": "euros,"}, {"s": 35.133, "e": 36.371, "t": "for going thirty kilometers"}, {"s": 36.371, "e": 37.224, "t": "per hour over the"}, {"s": 37.224, "e": 38.312, "t": "limit!"}, {"s": 38.312, "e": 39.464, "t": "Should fines depend on"}, {"s": 39.464, "e": 40.801, "t": "income?"}, {"s": 40.801, "e": 41.782, "t": "Comment below,"}, {"s": 41.782, "e": 43.019, "t": "and subscribe for more!"}]