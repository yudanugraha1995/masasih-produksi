[{"s": 0, "e": 1.145, "t": "How cold can it"}, {"s": 1.145, "e": 3.104, "t": "get where people live?"}, {"s": 3.104, "e": 4.735, "t": "Let's find out."}, {"s": 4.735, "e": 5.845, "t": "Australia:"}, {"s": 5.845, "e": 7.167, "t": "minus twenty three degrees"}, {"s": 7.167, "e": 7.978, "t": "Celsius,"}, {"s": 7.978, "e": 10.051, "t": "in the Snowy Mountains."}, {"s": 10.051, "e": 11.117, "t": "The UK:"}, {"s": 11.117, "e": 12.44, "t": "minus twenty seven point"}, {"s": 12.44, "e": 12.867, "t": "two,"}, {"s": 12.867, "e": 14.633, "t": "in Scotland."}, {"s": 14.633, "e": 15.401, "t": "Norway:"}, {"s": 15.401, "e": 16.766, "t": "minus fifty one point"}, {"s": 16.766, "e": 17.927, "t": "four!"}, {"s": 17.927, "e": 18.866, "t": "America:"}, {"s": 18.866, "e": 20.146, "t": "minus sixty two point"}, {"s": 20.146, "e": 20.658, "t": "two,"}, {"s": 20.658, "e": 22.226, "t": "in Alaska."}, {"s": 22.226, "e": 23.079, "t": "Canada:"}, {"s": 23.079, "e": 24.402, "t": "minus sixty three,"}, {"s": 24.402, "e": 25.682, "t": "in the Yukon,"}, {"s": 25.682, "e": 27.047, "t": "so cold that people's"}, {"s": 27.047, "e": 28.157, "t": "breath made a hissing"}, {"s": 28.157, "e": 29.375, "t": "sound!"}, {"s": 29.375, "e": 31.121, "t": "Think that's cold?"}, {"s": 31.121, "e": 32.797, "t": "Here's the twist."}, {"s": 32.797, "e": 33.607, "t": "Russia:"}, {"s": 33.607, "e": 35.058, "t": "minus sixty seven point"}, {"s": 35.058, "e": 37.191, "t": "eight degrees in Oymyakon,"}, {"s": 37.191, "e": 38.258, "t": "and about five hundred"}, {"s": 38.258, "e": 39.367, "t": "people still live there"}, {"s": 39.367, "e": 40.306, "t": "all year,"}, {"s": 40.306, "e": 41.373, "t": "where kids only stay"}, {"s": 41.373, "e": 42.525, "t": "home from school when"}, {"s": 42.525, "e": 43.634, "t": "it drops below about"}, {"s": 43.634, "e": 45.292, "t": "minus fifty!"}, {"s": 45.292, "e": 46.145, "t": "How cold does it"}, {"s": 46.145, "e": 47.793, "t": "get where you live?"}, {"s": 47.793, "e": 48.732, "t": "Comment below,"}, {"s": 48.732, "e": 50.097, "t": "and subscribe for more!"}]