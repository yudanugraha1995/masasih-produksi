[{"s": 0, "e": 1.187, "t": "Is America the biggest"}, {"s": 1.187, "e": 3.05, "t": "country in the world?"}, {"s": 3.05, "e": 4.563, "t": "Let's measure."}, {"s": 4.563, "e": 5.501, "t": "Australia:"}, {"s": 5.501, "e": 6.653, "t": "about seven point seven"}, {"s": 6.653, "e": 7.976, "t": "million square kilometers,"}, {"s": 7.976, "e": 8.659, "t": "the size of a"}, {"s": 8.659, "e": 10.229, "t": "whole continent."}, {"s": 10.229, "e": 11.04, "t": "Brazil:"}, {"s": 11.04, "e": 11.723, "t": "eight and a half"}, {"s": 11.723, "e": 12.192, "t": "million,"}, {"s": 12.192, "e": 13.387, "t": "almost half of South"}, {"s": 13.387, "e": 14.738, "t": "America."}, {"s": 14.738, "e": 15.506, "t": "China:"}, {"s": 15.506, "e": 17.635, "t": "nine point six million."}, {"s": 17.635, "e": 18.403, "t": "America:"}, {"s": 18.403, "e": 19.598, "t": "nine point eight million,"}, {"s": 19.598, "e": 20.366, "t": "depending on how you"}, {"s": 20.366, "e": 21.8, "t": "count water."}, {"s": 21.8, "e": 22.525, "t": "Canada:"}, {"s": 22.525, "e": 23.677, "t": "almost ten million,"}, {"s": 23.677, "e": 24.573, "t": "with more lakes than"}, {"s": 24.573, "e": 26.261, "t": "any other country!"}, {"s": 26.261, "e": 27.977, "t": "Think that's big?"}, {"s": 27.977, "e": 29.581, "t": "Here's the twist."}, {"s": 29.581, "e": 30.307, "t": "Russia:"}, {"s": 30.307, "e": 31.672, "t": "seventeen point one million"}, {"s": 31.672, "e": 32.696, "t": "square kilometers,"}, {"s": 32.696, "e": 33.763, "t": "almost twice the size"}, {"s": 33.763, "e": 34.573, "t": "of Canada,"}, {"s": 34.573, "e": 35.597, "t": "and it spans eleven"}, {"s": 35.597, "e": 37.149, "t": "time zones!"}, {"s": 37.149, "e": 37.704, "t": "How big is your"}, {"s": 37.704, "e": 38.995, "t": "country?"}, {"s": 38.995, "e": 39.891, "t": "Comment below,"}, {"s": 39.891, "e": 41.256, "t": "and subscribe for more!"}]