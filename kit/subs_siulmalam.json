[{"s": 0.08, "e": 1.28, "t": "Gimana kalau kamu siul"}, {"s": 1.36, "e": 2.04, "t": "malam-malam?"}, {"s": 2.24, "e": 3.28, "t": "Katanya bisa manggil makhluk"}, {"s": 3.36, "e": 4.08, "t": "halus!"}, {"s": 4.32, "e": 5.28, "t": "Masa sih?"}, {"s": 5.52, "e": 6.28, "t": "Faktanya,"}, {"s": 6.4, "e": 7.6, "t": "belum ada bukti siulan"}, {"s": 7.64, "e": 8.8, "t": "bisa manggil hantu."}, {"s": 9.04, "e": 10.32, "t": "Larangan ini muncul biar"}, {"s": 10.4, "e": 11.84, "t": "nggak ganggu orang tidur,"}, {"s": 11.92, "e": 12.8, "t": "dan dulu di dekat"}, {"s": 12.88, "e": 13.52, "t": "hutan,"}, {"s": 13.6, "e": 15.12, "t": "siulan bisa mancing binatang"}, {"s": 15.2, "e": 15.72, "t": "liar."}, {"s": 15.82, "e": 16.58, "t": "Plot twist:"}, {"s": 16.66, "e": 17.94, "t": "yang beneran datang biasanya"}, {"s": 18.06, "e": 19.54, "t": "tetangga yang marah!"}, {"s": 19.62, "e": 20.58, "t": "Kamu berani siul malam"}, {"s": 20.62, "e": 21.14, "t": "nggak?"}, {"s": 21.18, "e": 22.18, "t": "Jawab di komentar,"}, {"s": 22.26, "e": 23.3, "t": "dan subscribe ya!"}]