[{"s": 0, "e": 0.718, "t": "What if your dinner"}, {"s": 0.718, "e": 1.827, "t": "was a famous weird"}, {"s": 1.827, "e": 3.07, "t": "food?"}, {"s": 3.07, "e": 4.407, "t": "Let's look."}, {"s": 4.407, "e": 5.346, "t": "Japan:"}, {"s": 5.346, "e": 6.242, "t": "natto,"}, {"s": 6.242, "e": 7.693, "t": "sticky fermented soybeans with"}, {"s": 7.693, "e": 9.57, "t": "stretchy strings!"}, {"s": 9.57, "e": 10.551, "t": "Sweden:"}, {"s": 10.551, "e": 11.49, "t": "surströmming,"}, {"s": 11.49, "e": 13.069, "t": "fermented herring so smelly"}, {"s": 13.069, "e": 14.135, "t": "that many people open"}, {"s": 14.135, "e": 16.095, "t": "the can outdoors."}, {"s": 16.095, "e": 17.076, "t": "Iceland:"}, {"s": 17.076, "e": 18.143, "t": "hákarl,"}, {"s": 18.143, "e": 19.039, "t": "shark meat left to"}, {"s": 19.039, "e": 20.105, "t": "ferment and dry for"}, {"s": 20.105, "e": 21.471, "t": "months."}, {"s": 21.471, "e": 22.537, "t": "South Korea:"}, {"s": 22.537, "e": 23.391, "t": "sannakji,"}, {"s": 23.391, "e": 24.756, "t": "octopus served so fresh"}, {"s": 24.756, "e": 26.527, "t": "it's still wriggling."}, {"s": 26.527, "e": 27.508, "t": "Australia:"}, {"s": 27.508, "e": 28.575, "t": "witchetty grubs,"}, {"s": 28.575, "e": 29.641, "t": "fat white larvae that"}, {"s": 29.641, "e": 30.495, "t": "taste a bit like"}, {"s": 30.495, "e": 31.931, "t": "nutty egg."}, {"s": 31.931, "e": 33.605, "t": "But here's the twist."}, {"s": 33.605, "e": 34.543, "t": "America:"}, {"s": 34.543, "e": 35.439, "t": "at state fairs you"}, {"s": 35.439, "e": 36.421, "t": "can buy deep fried"}, {"s": 36.421, "e": 37.487, "t": "butter on a stick,"}, {"s": 37.487, "e": 38.554, "t": "and even deep fried"}, {"s": 38.554, "e": 39.717, "t": "soda!"}, {"s": 39.717, "e": 40.357, "t": "Which one would you"}, {"s": 40.357, "e": 41.563, "t": "try?"}, {"s": 41.563, "e": 42.459, "t": "Comment below,"}, {"s": 42.459, "e": 43.781, "t": "and subscribe for more!"}]