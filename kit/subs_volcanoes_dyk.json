[{"s": 0, "e": 1.017, "t": "What if a volcano"}, {"s": 1.017, "e": 1.742, "t": "was right next to"}, {"s": 1.742, "e": 3.184, "t": "your house?"}, {"s": 3.184, "e": 4.553, "t": "Let's look."}, {"s": 4.553, "e": 5.577, "t": "Iceland:"}, {"s": 5.577, "e": 7.199, "t": "about thirty active volcanic"}, {"s": 7.199, "e": 7.753, "t": "systems,"}, {"s": 7.753, "e": 8.564, "t": "on an island of"}, {"s": 8.564, "e": 9.801, "t": "just four hundred thousand"}, {"s": 9.801, "e": 10.988, "t": "people!"}, {"s": 10.988, "e": 12.012, "t": "Italy:"}, {"s": 12.012, "e": 13.377, "t": "Stromboli has been erupting"}, {"s": 13.377, "e": 14.828, "t": "almost nonstop for about"}, {"s": 14.828, "e": 16.602, "t": "two thousand years."}, {"s": 16.602, "e": 17.455, "t": "Japan:"}, {"s": 17.455, "e": 18.693, "t": "about one hundred eleven"}, {"s": 18.693, "e": 19.845, "t": "active volcanoes,"}, {"s": 19.845, "e": 20.698, "t": "roughly a tenth of"}, {"s": 20.698, "e": 22.289, "t": "the world's total."}, {"s": 22.289, "e": 23.313, "t": "Indonesia:"}, {"s": 23.313, "e": 24.337, "t": "about one hundred twenty"}, {"s": 24.337, "e": 25.83, "t": "seven active volcanoes,"}, {"s": 25.83, "e": 26.641, "t": "and an eruption in"}, {"s": 26.641, "e": 28.219, "t": "eighteen fifteen caused a"}, {"s": 28.219, "e": 30.355, "t": "year without a summer!"}, {"s": 30.355, "e": 31.464, "t": "Australia:"}, {"s": 31.464, "e": 32.616, "t": "no active volcanoes on"}, {"s": 32.616, "e": 33.512, "t": "the mainland,"}, {"s": 33.512, "e": 34.493, "t": "but Big Ben,"}, {"s": 34.493, "e": 35.389, "t": "on its remote Heard"}, {"s": 35.389, "e": 36.115, "t": "Island,"}, {"s": 36.115, "e": 37.637, "t": "still erupts."}, {"s": 37.637, "e": 39.348, "t": "But here's the twist."}, {"s": 39.348, "e": 40.415, "t": "America:"}, {"s": 40.415, "e": 41.695, "t": "about one hundred sixty"}, {"s": 41.695, "e": 43.871, "t": "one potentially active volcanoes,"}, {"s": 43.871, "e": 45.151, "t": "mostly in Alaska,"}, {"s": 45.151, "e": 47.725, "t": "plus the Yellowstone supervolcano!"}, {"s": 47.725, "e": 48.45, "t": "Would you live near"}, {"s": 48.45, "e": 49.987, "t": "a volcano?"}, {"s": 49.987, "e": 50.968, "t": "Comment below,"}, {"s": 50.968, "e": 52.205, "t": "and subscribe for more!"}]