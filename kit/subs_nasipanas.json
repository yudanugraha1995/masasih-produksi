[{"s": 0.0, "e": 1.6, "t": "Nasi sisa dipanasin,"}, {"s": 1.68, "e": 3.16, "t": "besoknya dipanasin lagi?"}, {"s": 3.36, "e": 4.4, "t": "Masa sih bisa jadi"}, {"s": 4.52, "e": 5.0, "t": "racun?"}, {"s": 5.2, "e": 7.16, "t": "Ternyata ada benarnya!"}, {"s": 7.36, "e": 8.72, "t": "Beras bisa membawa spora"}, {"s": 8.8, "e": 10.52, "t": "bakteri Bacillus cereus."}, {"s": 10.72, "e": 12.4, "t": "Spora ini tahan panas,"}, {"s": 12.48, "e": 13.44, "t": "jadi nggak mati waktu"}, {"s": 13.48, "e": 14.48, "t": "nasi dimasak."}, {"s": 14.56, "e": 15.52, "t": "Kalau nasi dibiarkan di"}, {"s": 15.6, "e": 16.96, "t": "suhu ruang berjam-jam,"}, {"s": 17.04, "e": 18.8, "t": "sporanya tumbuh dan menghasilkan"}, {"s": 18.96, "e": 19.36, "t": "racun."}, {"s": 19.38, "e": 20.34, "t": "Masalahnya,"}, {"s": 20.46, "e": 22.18, "t": "racun ini tahan panas,"}, {"s": 22.26, "e": 23.46, "t": "jadi dipanasin ulang pun"}, {"s": 23.54, "e": 24.18, "t": "nggak hilang."}, {"s": 24.28, "e": 25.16, "t": "Plot twist:"}, {"s": 25.24, "e": 27.24, "t": "yang bahaya bukan dipanasinnya,"}, {"s": 27.32, "e": 28.52, "t": "tapi nasi yang kelamaan"}, {"s": 28.56, "e": 29.56, "t": "dibiarkan di luar!"}, {"s": 29.58, "e": 30.94, "t": "Gejalanya mual,"}, {"s": 30.98, "e": 31.58, "t": "muntah,"}, {"s": 31.74, "e": 32.54, "t": "sampai diare."}, {"s": 32.56, "e": 33.36, "t": "Biar aman,"}, {"s": 33.44, "e": 34.32, "t": "masukkan sisa nasi ke"}, {"s": 34.4, "e": 35.92, "t": "kulkas dalam satu jam,"}, {"s": 36.0, "e": 37.36, "t": "dan panaskan cukup sekali"}, {"s": 37.44, "e": 38.88, "t": "sampai benar-benar panas."}, {"s": 38.98, "e": 40.1, "t": "Kamu tim nasi sisa"}, {"s": 40.26, "e": 41.62, "t": "atau tim masak baru?"}, {"s": 41.66, "e": 42.74, "t": "Tulis di komentar,"}, {"s": 42.82, "e": 43.887, "t": "dan subscribe biar nggak"}, {"s": 43.913, "e": 44.74, "t": "ketinggalan!"}]