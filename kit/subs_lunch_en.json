[{"s": 0.0, "e": 0.6, "t": "Did you know one"}, {"s": 0.6, "e": 1.539, "t": "of the richest countries"}, {"s": 1.539, "e": 2.648, "t": "on Earth has NO"}, {"s": 2.648, "e": 4.483, "t": "national free school lunch?"}, {"s": 4.483, "e": 5.379, "t": "Around the world,"}, {"s": 5.379, "e": 7.64, "t": "466 million kids eat"}, {"s": 7.64, "e": 9.048, "t": "meals at school."}, {"s": 9.048, "e": 9.645, "t": "In America,"}, {"s": 9.645, "e": 10.712, "t": "the school lunch program"}, {"s": 10.712, "e": 12.76, "t": "runs in over 101,000"}, {"s": 12.76, "e": 13.912, "t": "schools."}, {"s": 13.912, "e": 14.723, "t": "In the UK,"}, {"s": 14.723, "e": 15.917, "t": "every kid aged four"}, {"s": 15.917, "e": 16.984, "t": "to seven eats lunch"}, {"s": 16.984, "e": 18.136, "t": "for free."}, {"s": 18.136, "e": 19.373, "t": "Indonesia just launched one"}, {"s": 19.373, "e": 20.696, "t": "of the biggest programs"}, {"s": 20.696, "e": 21.336, "t": "ever,"}, {"s": 21.336, "e": 22.659, "t": "feeding about 60 million"}, {"s": 22.659, "e": 23.64, "t": "people."}, {"s": 23.64, "e": 24.792, "t": "The plot twist?"}, {"s": 24.792, "e": 25.816, "t": "That rich country is"}, {"s": 25.816, "e": 27.096, "t": "Australia."}, {"s": 27.096, "e": 28.035, "t": "Only some schools in"}, {"s": 28.035, "e": 29.784, "t": "Tasmania get free lunch."}, {"s": 29.784, "e": 30.552, "t": "Should your country do"}, {"s": 30.552, "e": 31.149, "t": "it?"}, {"s": 31.149, "e": 32.045, "t": "Comment below!"}]