[{"s": 0, "e": 1.059, "t": "What if your national"}, {"s": 1.059, "e": 1.998, "t": "anthem had a hundred"}, {"s": 1.998, "e": 4.385, "t": "and fifty eight verses?"}, {"s": 4.385, "e": 6.029, "t": "Let's listen."}, {"s": 6.029, "e": 6.925, "t": "America:"}, {"s": 6.925, "e": 8.375, "t": "the Star Spangled Banner"}, {"s": 8.375, "e": 9.826, "t": "has four verses,"}, {"s": 9.826, "e": 11.149, "t": "and usually only the"}, {"s": 11.149, "e": 12.859, "t": "first is sung."}, {"s": 12.859, "e": 14.097, "t": "Australia:"}, {"s": 14.097, "e": 15.334, "t": "changed one line in"}, {"s": 15.334, "e": 16.571, "t": "twenty twenty one,"}, {"s": 16.571, "e": 17.766, "t": "from young and free,"}, {"s": 17.766, "e": 19.683, "t": "to one and free."}, {"s": 19.683, "e": 20.664, "t": "The UK:"}, {"s": 20.664, "e": 21.987, "t": "God Save the King,"}, {"s": 21.987, "e": 23.181, "t": "changed from Queen in"}, {"s": 23.181, "e": 24.935, "t": "twenty twenty two."}, {"s": 24.935, "e": 25.873, "t": "Japan:"}, {"s": 25.873, "e": 26.855, "t": "Kimigayo,"}, {"s": 26.855, "e": 27.623, "t": "one of the shortest"}, {"s": 27.623, "e": 28.817, "t": "anthems in the world,"}, {"s": 28.817, "e": 29.927, "t": "with just thirty two"}, {"s": 29.927, "e": 31.433, "t": "syllables."}, {"s": 31.433, "e": 32.287, "t": "Spain:"}, {"s": 32.287, "e": 33.439, "t": "the Marcha Real has"}, {"s": 33.439, "e": 34.719, "t": "no official words,"}, {"s": 34.719, "e": 36.755, "t": "so players just hum!"}, {"s": 36.755, "e": 38.553, "t": "But here's the twist."}, {"s": 38.553, "e": 39.364, "t": "Greece:"}, {"s": 39.364, "e": 40.345, "t": "the Hymn to Liberty"}, {"s": 40.345, "e": 41.711, "t": "has one hundred fifty"}, {"s": 41.711, "e": 42.735, "t": "eight verses,"}, {"s": 42.735, "e": 43.972, "t": "the longest anthem on"}, {"s": 43.972, "e": 44.569, "t": "Earth,"}, {"s": 44.569, "e": 45.508, "t": "but only two are"}, {"s": 45.508, "e": 47.219, "t": "usually sung!"}, {"s": 47.219, "e": 47.859, "t": "Do you know your"}, {"s": 47.859, "e": 49.699, "t": "anthem by heart?"}, {"s": 49.699, "e": 50.723, "t": "Comment below,"}, {"s": 50.723, "e": 52.131, "t": "and subscribe for more!"}]