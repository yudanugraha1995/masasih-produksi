[{"s": 0, "e": 1.23, "t": "What if wild hippos"}, {"s": 1.23, "e": 3.03, "t": "lived in your country?"}, {"s": 3.03, "e": 3.969, "t": "Let's check the wild"}, {"s": 3.969, "e": 5.983, "t": "giants around the world."}, {"s": 5.983, "e": 6.879, "t": "America:"}, {"s": 6.879, "e": 7.946, "t": "Florida has about one"}, {"s": 7.946, "e": 10.469, "t": "point three million alligators!"}, {"s": 10.469, "e": 11.408, "t": "Australia:"}, {"s": 11.408, "e": 12.56, "t": "about one hundred thousand"}, {"s": 12.56, "e": 13.883, "t": "saltwater crocodiles in the"}, {"s": 13.883, "e": 16.027, "t": "Northern Territory alone."}, {"s": 16.027, "e": 16.667, "t": "India:"}, {"s": 16.667, "e": 17.819, "t": "about three thousand seven"}, {"s": 17.819, "e": 19.142, "t": "hundred wild tigers,"}, {"s": 19.142, "e": 20.123, "t": "three quarters of all"}, {"s": 20.123, "e": 22.04, "t": "wild tigers on Earth."}, {"s": 22.04, "e": 23.021, "t": "Indonesia:"}, {"s": 23.021, "e": 24.344, "t": "about three thousand Komodo"}, {"s": 24.344, "e": 25.112, "t": "dragons,"}, {"s": 25.112, "e": 27.834, "t": "the biggest lizards alive."}, {"s": 27.834, "e": 28.858, "t": "South Africa:"}, {"s": 28.858, "e": 30.01, "t": "Kruger Park alone has"}, {"s": 30.01, "e": 32.207, "t": "over three thousand hippos."}, {"s": 32.207, "e": 33.871, "t": "But here's the twist."}, {"s": 33.871, "e": 34.81, "t": "Colombia:"}, {"s": 34.81, "e": 35.834, "t": "about two hundred wild"}, {"s": 35.834, "e": 36.559, "t": "hippos,"}, {"s": 36.559, "e": 37.455, "t": "all from just four"}, {"s": 37.455, "e": 38.522, "t": "that drug lord Pablo"}, {"s": 38.522, "e": 39.503, "t": "Escobar brought to his"}, {"s": 39.503, "e": 41.045, "t": "private zoo!"}, {"s": 41.045, "e": 42.24, "t": "Which wild animal would"}, {"s": 42.24, "e": 43.787, "t": "scare you most?"}, {"s": 43.787, "e": 44.555, "t": "Comment below,"}, {"s": 44.555, "e": 45.792, "t": "and subscribe for more!"}]