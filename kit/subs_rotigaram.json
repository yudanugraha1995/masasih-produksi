[{"s": 0, "e": 1.44, "t": "Roti garam lagi viral"}, {"s": 1.48, "e": 2.28, "t": "di mana-mana."}, {"s": 2.48, "e": 4.8, "t": "Gurih dan antreannya panjang."}, {"s": 5.04, "e": 6.48, "t": "Tapi masa sih bisa"}, {"s": 6.52, "e": 7.64, "t": "bikin darah tinggi?"}, {"s": 7.92, "e": 8.68, "t": "Faktanya,"}, {"s": 8.8, "e": 10.16, "t": "roti garam itu adonan"}, {"s": 10.24, "e": 11.28, "t": "berisi mentega,"}, {"s": 11.36, "e": 12.8, "t": "lalu ditaburi garam kasar"}, {"s": 12.88, "e": 13.52, "t": "di atasnya."}, {"s": 13.62, "e": 14.74, "t": "Jadi ada garam dari"}, {"s": 14.82, "e": 15.54, "t": "adonan,"}, {"s": 15.66, "e": 16.82, "t": "plus garam taburan,"}, {"s": 16.94, "e": 18.42, "t": "plus lemak dari mentega."}, {"s": 18.66, "e": 20.66, "t": "WHO menyarankan garam maksimal"}, {"s": 20.74, "e": 22.1, "t": "lima gram sehari,"}, {"s": 22.14, "e": 23.7, "t": "kira-kira satu sendok teh,"}, {"s": 23.78, "e": 25.18, "t": "dari semua makanan."}, {"s": 25.38, "e": 26.26, "t": "Plot twist:"}, {"s": 26.34, "e": 27.38, "t": "satu roti garam nggak"}, {"s": 27.46, "e": 28.82, "t": "langsung bikin darah tinggi!"}, {"s": 28.84, "e": 30.36, "t": "Yang bahaya itu total"}, {"s": 30.44, "e": 31.56, "t": "garam harianmu:"}, {"s": 31.64, "e": 32.6, "t": "roti garam,"}, {"s": 32.68, "e": 33.56, "t": "mi instan,"}, {"s": 33.68, "e": 34.28, "t": "kecap,"}, {"s": 34.4, "e": 34.84, "t": "saus,"}, {"s": 34.92, "e": 36.28, "t": "dan camilan asin kalau"}, {"s": 36.36, "e": 37.04, "t": "dijumlah."}, {"s": 37.24, "e": 38.76, "t": "Jadi boleh jajan,"}, {"s": 38.88, "e": 40.6, "t": "asal sesekali dan imbangi"}, {"s": 40.68, "e": 41.4, "t": "air putih,"}, {"s": 41.52, "e": 41.96, "t": "sayur,"}, {"s": 42.04, "e": 42.52, "t": "dan buah."}, {"s": 42.62, "e": 43.58, "t": "Kamu udah nyobain roti"}, {"s": 43.62, "e": 44.38, "t": "garam belum?"}, {"s": 44.54, "e": 45.66, "t": "Tulis di komentar,"}, {"s": 45.74, "e": 46.94, "t": "dan subscribe biar nggak"}, {"s": 47.02, "e": 47.82, "t": "ketinggalan!"}]