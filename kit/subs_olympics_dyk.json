[{"s": 0, "e": 1.017, "t": "What if your country"}, {"s": 1.017, "e": 2.083, "t": "won the most Olympic"}, {"s": 2.083, "e": 3.324, "t": "gold?"}, {"s": 3.324, "e": 4.732, "t": "Let's count Summer Olympic"}, {"s": 4.732, "e": 6.578, "t": "golds of all time."}, {"s": 6.578, "e": 7.474, "t": "Australia:"}, {"s": 7.474, "e": 8.925, "t": "about one hundred eighty,"}, {"s": 8.925, "e": 9.906, "t": "impressive for a country"}, {"s": 9.906, "e": 11.96, "t": "of twenty seven million!"}, {"s": 11.96, "e": 12.813, "t": "Japan:"}, {"s": 12.813, "e": 14.136, "t": "about one hundred ninety,"}, {"s": 14.136, "e": 15.075, "t": "with judo as its"}, {"s": 15.075, "e": 16.692, "t": "golden sport."}, {"s": 16.692, "e": 17.375, "t": "France:"}, {"s": 17.375, "e": 18.569, "t": "about two hundred forty,"}, {"s": 18.569, "e": 19.551, "t": "after hosting the Games"}, {"s": 19.551, "e": 21.399, "t": "in twenty twenty four."}, {"s": 21.399, "e": 22.209, "t": "The UK:"}, {"s": 22.209, "e": 23.897, "t": "about three hundred."}, {"s": 23.897, "e": 24.537, "t": "China:"}, {"s": 24.537, "e": 25.774, "t": "about three hundred too,"}, {"s": 25.774, "e": 27.669, "t": "and growing fast!"}, {"s": 27.669, "e": 29.547, "t": "But here's the twist."}, {"s": 29.547, "e": 30.358, "t": "America:"}, {"s": 30.358, "e": 31.467, "t": "over one thousand one"}, {"s": 31.467, "e": 32.79, "t": "hundred gold medals,"}, {"s": 32.79, "e": 33.515, "t": "more than the next"}, {"s": 33.515, "e": 34.881, "t": "three countries combined,"}, {"s": 34.881, "e": 36.118, "t": "and Michael Phelps alone"}, {"s": 36.118, "e": 37.903, "t": "has twenty three!"}, {"s": 37.903, "e": 38.714, "t": "Which sport would you"}, {"s": 38.714, "e": 40.273, "t": "win gold in?"}, {"s": 40.273, "e": 41.127, "t": "Comment below,"}, {"s": 41.127, "e": 42.449, "t": "and subscribe for more!"}]