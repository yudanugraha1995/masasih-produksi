[{"s": 0, "e": 1.059, "t": "What if your country"}, {"s": 1.059, "e": 3.0, "t": "sent you to space?"}, {"s": 3.0, "e": 4.536, "t": "Let's count."}, {"s": 4.536, "e": 5.603, "t": "Russia:"}, {"s": 5.603, "e": 7.011, "t": "Yuri Gagarin became the"}, {"s": 7.011, "e": 8.12, "t": "first human in space"}, {"s": 8.12, "e": 9.827, "t": "in nineteen sixty one,"}, {"s": 9.827, "e": 11.405, "t": "and Valentina Tereshkova the"}, {"s": 11.405, "e": 12.833, "t": "first woman."}, {"s": 12.833, "e": 13.643, "t": "China:"}, {"s": 13.643, "e": 14.881, "t": "in twenty oh three"}, {"s": 14.881, "e": 15.862, "t": "it became the third"}, {"s": 15.862, "e": 16.929, "t": "country to launch people"}, {"s": 16.929, "e": 18.853, "t": "on its own rockets."}, {"s": 18.853, "e": 19.919, "t": "Japan:"}, {"s": 19.919, "e": 20.986, "t": "sent the first journalist"}, {"s": 20.986, "e": 21.882, "t": "to space,"}, {"s": 21.882, "e": 23.811, "t": "back in nineteen ninety."}, {"s": 23.811, "e": 24.622, "t": "Canada:"}, {"s": 24.622, "e": 26.286, "t": "astronaut Chris Hadfield sang"}, {"s": 26.286, "e": 27.395, "t": "a David Bowie song"}, {"s": 27.395, "e": 28.633, "t": "on the space station,"}, {"s": 28.633, "e": 30.432, "t": "and millions watched!"}, {"s": 30.432, "e": 31.499, "t": "Australia:"}, {"s": 31.499, "e": 32.779, "t": "its first astronaut,"}, {"s": 32.779, "e": 33.717, "t": "Andy Thomas,"}, {"s": 33.717, "e": 34.4, "t": "had to become an"}, {"s": 34.4, "e": 35.765, "t": "American citizen to fly"}, {"s": 35.765, "e": 37.245, "t": "with NASA."}, {"s": 37.245, "e": 38.936, "t": "But here's the twist."}, {"s": 38.936, "e": 39.832, "t": "America:"}, {"s": 39.832, "e": 40.771, "t": "has sent over three"}, {"s": 40.771, "e": 42.008, "t": "hundred fifty people to"}, {"s": 42.008, "e": 42.605, "t": "space,"}, {"s": 42.605, "e": 43.544, "t": "and it's still the"}, {"s": 43.544, "e": 44.355, "t": "only country that has"}, {"s": 44.355, "e": 45.464, "t": "walked on the Moon,"}, {"s": 45.464, "e": 47.283, "t": "twelve men in all!"}, {"s": 47.283, "e": 47.923, "t": "Would you go to"}, {"s": 47.923, "e": 49.176, "t": "space?"}, {"s": 49.176, "e": 50.157, "t": "Comment below,"}, {"s": 50.157, "e": 51.522, "t": "and subscribe for more!"}]