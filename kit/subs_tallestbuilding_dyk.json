[{"s": 0, "e": 0.974, "t": "Where is the tallest"}, {"s": 0.974, "e": 2.536, "t": "building on Earth?"}, {"s": 2.536, "e": 3.821, "t": "Let's go up."}, {"s": 3.821, "e": 4.887, "t": "The UK:"}, {"s": 4.887, "e": 6.039, "t": "the Shard in London,"}, {"s": 6.039, "e": 7.92, "t": "three hundred ten meters."}, {"s": 7.92, "e": 8.859, "t": "Australia:"}, {"s": 8.859, "e": 9.413, "t": "Q one on the"}, {"s": 9.413, "e": 10.352, "t": "Gold Coast,"}, {"s": 10.352, "e": 11.163, "t": "three hundred twenty two"}, {"s": 11.163, "e": 12.341, "t": "meters."}, {"s": 12.341, "e": 13.365, "t": "America:"}, {"s": 13.365, "e": 14.688, "t": "One World Trade Center,"}, {"s": 14.688, "e": 15.669, "t": "five hundred forty one"}, {"s": 15.669, "e": 16.352, "t": "meters,"}, {"s": 16.352, "e": 17.376, "t": "that's one thousand seven"}, {"s": 17.376, "e": 18.912, "t": "hundred seventy six feet,"}, {"s": 18.912, "e": 19.552, "t": "for the year of"}, {"s": 19.552, "e": 21.14, "t": "independence!"}, {"s": 21.14, "e": 21.951, "t": "China:"}, {"s": 21.951, "e": 23.145, "t": "Shanghai Tower,"}, {"s": 23.145, "e": 24.127, "t": "six hundred thirty two"}, {"s": 24.127, "e": 25.405, "t": "meters."}, {"s": 25.405, "e": 26.387, "t": "Malaysia:"}, {"s": 26.387, "e": 27.837, "t": "Merdeka one eighteen,"}, {"s": 27.837, "e": 28.947, "t": "six hundred seventy nine"}, {"s": 28.947, "e": 30.247, "t": "meters!"}, {"s": 30.247, "e": 31.898, "t": "Think that's tall?"}, {"s": 31.898, "e": 33.451, "t": "Here's the twist."}, {"s": 33.451, "e": 34.176, "t": "Dubai:"}, {"s": 34.176, "e": 35.243, "t": "the Burj Khalifa,"}, {"s": 35.243, "e": 36.139, "t": "eight hundred twenty eight"}, {"s": 36.139, "e": 36.779, "t": "meters,"}, {"s": 36.779, "e": 37.248, "t": "and you can see"}, {"s": 37.248, "e": 38.187, "t": "its tip from almost"}, {"s": 38.187, "e": 40.402, "t": "a hundred kilometers away!"}, {"s": 40.402, "e": 41.383, "t": "What's the tallest building"}, {"s": 41.383, "e": 42.641, "t": "near you?"}, {"s": 42.641, "e": 43.495, "t": "Comment below,"}, {"s": 43.495, "e": 44.732, "t": "and subscribe for more!"}]