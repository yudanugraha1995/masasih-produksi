[{"s": 0, "e": 1.102, "t": "Which country has the"}, {"s": 1.102, "e": 2.834, "t": "most islands?"}, {"s": 2.834, "e": 4.725, "t": "Let's count up."}, {"s": 4.725, "e": 6.005, "t": "The Philippines:"}, {"s": 6.005, "e": 7.199, "t": "about seven thousand six"}, {"s": 7.199, "e": 8.138, "t": "hundred islands,"}, {"s": 8.138, "e": 9.119, "t": "and some only appear"}, {"s": 9.119, "e": 10.705, "t": "at low tide."}, {"s": 10.705, "e": 11.643, "t": "Australia:"}, {"s": 11.643, "e": 12.539, "t": "over eight thousand two"}, {"s": 12.539, "e": 13.094, "t": "hundred,"}, {"s": 13.094, "e": 14.289, "t": "including the famous Fraser"}, {"s": 14.289, "e": 14.843, "t": "Island,"}, {"s": 14.843, "e": 16.404, "t": "now K'gari."}, {"s": 16.404, "e": 17.215, "t": "Japan:"}, {"s": 17.215, "e": 18.409, "t": "about fourteen thousand,"}, {"s": 18.409, "e": 19.263, "t": "after a new count"}, {"s": 19.263, "e": 21.047, "t": "in twenty twenty three."}, {"s": 21.047, "e": 21.857, "t": "Indonesia:"}, {"s": 21.857, "e": 24.195, "t": "more than seventeen thousand!"}, {"s": 24.195, "e": 25.006, "t": "America:"}, {"s": 25.006, "e": 26.286, "t": "around eighteen thousand six"}, {"s": 26.286, "e": 26.883, "t": "hundred,"}, {"s": 26.883, "e": 29.106, "t": "counting Alaska and Hawaii."}, {"s": 29.106, "e": 30.689, "t": "Think that's a lot?"}, {"s": 30.689, "e": 32.405, "t": "Here's the twist."}, {"s": 32.405, "e": 33.343, "t": "Sweden:"}, {"s": 33.343, "e": 34.453, "t": "about two hundred sixty"}, {"s": 34.453, "e": 35.733, "t": "seven thousand islands,"}, {"s": 35.733, "e": 36.33, "t": "the most in the"}, {"s": 36.33, "e": 36.927, "t": "world,"}, {"s": 36.927, "e": 37.994, "t": "and most have nobody"}, {"s": 37.994, "e": 39.481, "t": "living on them!"}, {"s": 39.481, "e": 40.377, "t": "How many islands does"}, {"s": 40.377, "e": 42.073, "t": "your country have?"}, {"s": 42.073, "e": 42.969, "t": "Comment below,"}, {"s": 42.969, "e": 44.291, "t": "and subscribe for more!"}]