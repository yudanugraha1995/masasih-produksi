[{"s": 0, "e": 0.974, "t": "What if every store"}, {"s": 0.974, "e": 2.731, "t": "closed on Sunday?"}, {"s": 2.731, "e": 4.362, "t": "Let's compare."}, {"s": 4.362, "e": 5.258, "t": "America:"}, {"s": 5.258, "e": 6.623, "t": "most stores open seven"}, {"s": 6.623, "e": 7.477, "t": "days a week,"}, {"s": 7.477, "e": 8.861, "t": "some all night."}, {"s": 8.861, "e": 9.885, "t": "Australia:"}, {"s": 9.885, "e": 11.122, "t": "open on Sundays too,"}, {"s": 11.122, "e": 11.975, "t": "though some stores open"}, {"s": 11.975, "e": 13.081, "t": "later."}, {"s": 13.081, "e": 14.276, "t": "The UK:"}, {"s": 14.276, "e": 15.428, "t": "big stores can only"}, {"s": 15.428, "e": 16.665, "t": "open for six hours,"}, {"s": 16.665, "e": 18.7, "t": "usually ten to four."}, {"s": 18.7, "e": 19.553, "t": "Switzerland:"}, {"s": 19.553, "e": 20.833, "t": "most shops stay closed,"}, {"s": 20.833, "e": 22.028, "t": "except at train stations"}, {"s": 22.028, "e": 23.659, "t": "and airports."}, {"s": 23.659, "e": 24.469, "t": "Germany:"}, {"s": 24.469, "e": 25.451, "t": "nearly all shops are"}, {"s": 25.451, "e": 26.432, "t": "closed by law,"}, {"s": 26.432, "e": 27.456, "t": "so everyone rushes to"}, {"s": 27.456, "e": 29.565, "t": "the supermarket on Saturday!"}, {"s": 29.565, "e": 31.245, "t": "But here's the twist."}, {"s": 31.245, "e": 32.312, "t": "Poland:"}, {"s": 32.312, "e": 33.293, "t": "shopping is banned on"}, {"s": 33.293, "e": 34.403, "t": "most Sundays,"}, {"s": 34.403, "e": 35.171, "t": "only a few Sundays"}, {"s": 35.171, "e": 36.493, "t": "a year are allowed,"}, {"s": 36.493, "e": 37.603, "t": "mostly before Christmas and"}, {"s": 37.603, "e": 38.864, "t": "Easter!"}, {"s": 38.864, "e": 39.589, "t": "Would you survive a"}, {"s": 39.589, "e": 41.637, "t": "Sunday with no shopping?"}, {"s": 41.637, "e": 42.575, "t": "Comment below,"}, {"s": 42.575, "e": 43.77, "t": "and subscribe for more!"}]