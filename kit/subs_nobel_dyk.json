[{"s": 0, "e": 0.931, "t": "What if your country"}, {"s": 0.931, "e": 3.1, "t": "collected Nobel Prizes?"}, {"s": 3.1, "e": 4.875, "t": "Let's count the winners."}, {"s": 4.875, "e": 5.814, "t": "Australia:"}, {"s": 5.814, "e": 6.753, "t": "about fifteen,"}, {"s": 6.753, "e": 8.033, "t": "including the scientists who"}, {"s": 8.033, "e": 9.611, "t": "discovered that bacteria cause"}, {"s": 9.611, "e": 11.285, "t": "stomach ulcers!"}, {"s": 11.285, "e": 12.053, "t": "Sweden:"}, {"s": 12.053, "e": 12.906, "t": "about thirty,"}, {"s": 12.906, "e": 13.589, "t": "home of the prize"}, {"s": 13.589, "e": 14.357, "t": "itself,"}, {"s": 14.357, "e": 16.447, "t": "handed out every December."}, {"s": 16.447, "e": 17.215, "t": "France:"}, {"s": 17.215, "e": 18.409, "t": "about seventy five,"}, {"s": 18.409, "e": 19.689, "t": "including Marie Curie,"}, {"s": 19.689, "e": 21.455, "t": "who won twice!"}, {"s": 21.455, "e": 22.181, "t": "Germany:"}, {"s": 22.181, "e": 23.503, "t": "about one hundred fifteen,"}, {"s": 23.503, "e": 25.635, "t": "including Albert Einstein."}, {"s": 25.635, "e": 26.659, "t": "The UK:"}, {"s": 26.659, "e": 27.854, "t": "about one hundred forty,"}, {"s": 27.854, "e": 29.219, "t": "including Alexander Fleming,"}, {"s": 29.219, "e": 31.175, "t": "who discovered penicillin."}, {"s": 31.175, "e": 32.954, "t": "But here's the twist."}, {"s": 32.954, "e": 33.807, "t": "America:"}, {"s": 33.807, "e": 34.874, "t": "over four hundred Nobel"}, {"s": 34.874, "e": 35.685, "t": "winners,"}, {"s": 35.685, "e": 36.794, "t": "more than the UK,"}, {"s": 36.794, "e": 39.022, "t": "Germany and France combined!"}, {"s": 39.022, "e": 41.297, "t": "Who's your favorite scientist?"}, {"s": 41.297, "e": 42.15, "t": "Comment below,"}, {"s": 42.15, "e": 43.387, "t": "and subscribe for more!"}]