[{"s": 0, "e": 1.315, "t": "What if everyone used"}, {"s": 1.315, "e": 2.884, "t": "kilometers?"}, {"s": 2.884, "e": 4.44, "t": "Let's compare."}, {"s": 4.44, "e": 5.293, "t": "Canada:"}, {"s": 5.293, "e": 6.445, "t": "kilometers on the road,"}, {"s": 6.445, "e": 7.384, "t": "but people still say"}, {"s": 7.384, "e": 9.331, "t": "their height in feet!"}, {"s": 9.331, "e": 10.355, "t": "Australia:"}, {"s": 10.355, "e": 11.294, "t": "fully metric since the"}, {"s": 11.294, "e": 13.09, "t": "nineteen seventies."}, {"s": 13.09, "e": 14.157, "t": "Japan:"}, {"s": 14.157, "e": 14.711, "t": "metric,"}, {"s": 14.711, "e": 15.735, "t": "but apartment rooms are"}, {"s": 15.735, "e": 16.973, "t": "often measured in tatami"}, {"s": 16.973, "e": 18.174, "t": "mats."}, {"s": 18.174, "e": 18.985, "t": "India:"}, {"s": 18.985, "e": 19.838, "t": "switched to metric in"}, {"s": 19.838, "e": 21.89, "t": "the late nineteen fifties."}, {"s": 21.89, "e": 22.914, "t": "The UK:"}, {"s": 22.914, "e": 24.023, "t": "metric in shops,"}, {"s": 24.023, "e": 25.005, "t": "but road signs are"}, {"s": 25.005, "e": 25.986, "t": "still in miles,"}, {"s": 25.986, "e": 26.967, "t": "and beer comes in"}, {"s": 26.967, "e": 28.184, "t": "pints!"}, {"s": 28.184, "e": 29.937, "t": "But here's the twist."}, {"s": 29.937, "e": 31.004, "t": "America:"}, {"s": 31.004, "e": 32.028, "t": "uses miles,"}, {"s": 32.028, "e": 33.393, "t": "pounds and Fahrenheit,"}, {"s": 33.393, "e": 34.033, "t": "and it's one of"}, {"s": 34.033, "e": 35.143, "t": "only three countries that"}, {"s": 35.143, "e": 36.807, "t": "never fully went metric,"}, {"s": 36.807, "e": 37.916, "t": "along with Liberia and"}, {"s": 37.916, "e": 39.371, "t": "Myanmar!"}, {"s": 39.371, "e": 41.518, "t": "Miles or kilometers?"}, {"s": 41.518, "e": 42.414, "t": "Comment below,"}, {"s": 42.414, "e": 43.822, "t": "and subscribe for more!"}]