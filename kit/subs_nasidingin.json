[{"s": 0.15, "e": 0.64, "t": "Woyyy!"}, {"s": 0.68, "e": 1.84, "t": "Kamu suka makan nasi"}, {"s": 1.867, "e": 2.88, "t": "anget yang baru mateng,"}, {"s": 2.907, "e": 3.88, "t": "masih ngebul?"}, {"s": 4.06, "e": 4.88, "t": "Sama!"}, {"s": 5.12, "e": 6.32, "t": "Tapi katanya,"}, {"s": 6.44, "e": 7.52, "t": "nasi sisa semalam yang"}, {"s": 7.56, "e": 9.12, "t": "disimpan di kulkas justru"}, {"s": 9.16, "e": 9.84, "t": "lebih sehat."}, {"s": 10.55, "e": 11.12, "t": "Masa sih?"}, {"s": 11.89, "e": 12.48, "t": "Yuk kita cek!"}, {"s": 13.573, "e": 15.125, "t": "Indonesia itu negara nasi."}, {"s": 15.285, "e": 16.325, "t": "Masalahnya,"}, {"s": 16.365, "e": 17.525, "t": "nasi putih cepat banget"}, {"s": 17.578, "e": 18.565, "t": "diubah jadi gula di"}, {"s": 18.605, "e": 19.285, "t": "dalam tubuh."}, {"s": 19.405, "e": 21.125, "t": "Padahal sekarang ada sekitar"}, {"s": 21.185, "e": 22.165, "t": "dua puluh juta orang"}, {"s": 22.205, "e": 23.525, "t": "dewasa di Indonesia yang"}, {"s": 23.585, "e": 24.885, "t": "hidup dengan diabetes."}, {"s": 25.513, "e": 26.405, "t": "Peringkat lima dunia,"}, {"s": 26.485, "e": 27.165, "t": "kak!"}, {"s": 27.735, "e": 27.845, "t": "Nah,"}, {"s": 27.872, "e": 28.805, "t": "di sinilah nasi dingin"}, {"s": 28.865, "e": 29.285, "t": "masuk."}, {"s": 29.485, "e": 31.045, "t": "Waktu nasi didinginkan,"}, {"s": 31.098, "e": 32.725, "t": "sebagian patinya menyusun ulang"}, {"s": 32.805, "e": 33.925, "t": "jadi pati resisten."}, {"s": 34.105, "e": 35.765, "t": "Pati ini bandel."}, {"s": 35.845, "e": 37.205, "t": "Dia susah dicerna,"}, {"s": 37.245, "e": 38.485, "t": "jadi nggak langsung berubah"}, {"s": 38.525, "e": 39.205, "t": "jadi gula."}, {"s": 39.365, "e": 40.725, "t": "Dia malah jalan terus"}, {"s": 40.752, "e": 41.685, "t": "ke usus besar dan"}, {"s": 41.765, "e": 43.685, "t": "jadi makanan bakteri baik."}, {"s": 43.805, "e": 46.325, "t": "Ada penelitian tahun 2015."}, {"s": 46.525, "e": 47.605, "t": "Nasi yang disimpan di"}, {"s": 47.665, "e": 48.725, "t": "kulkas dua puluh empat"}, {"s": 48.785, "e": 49.085, "t": "jam,"}, {"s": 49.145, "e": 50.565, "t": "lalu dipanaskan lagi,"}, {"s": 50.625, "e": 52.165, "t": "punya pati resisten sekitar"}, {"s": 52.225, "e": 53.445, "t": "dua setengah kali lipat"}, {"s": 53.485, "e": 54.645, "t": "dibanding nasi baru."}, {"s": 54.825, "e": 56.405, "t": "Lonjakan gula darah orang"}, {"s": 56.437, "e": 57.685, "t": "yang memakannya juga lebih"}, {"s": 57.733, "e": 58.165, "t": "rendah."}, {"s": 59.225, "e": 60.285, "t": "Tapi tunggu dulu."}, {"s": 60.375, "e": 61.605, "t": "Ini bukan berarti nasi"}, {"s": 61.653, "e": 62.965, "t": "dingin jadi makanan diet"}, {"s": 63.045, "e": 63.525, "t": "ajaib."}, {"s": 63.685, "e": 65.765, "t": "Kalorinya cuma turun sedikit,"}, {"s": 65.825, "e": 67.205, "t": "dan penelitiannya juga masih"}, {"s": 67.285, "e": 68.005, "t": "kecil,"}, {"s": 68.065, "e": 69.285, "t": "cuma lima belas orang."}, {"s": 69.485, "e": 71.045, "t": "Kalau makannya tetap dua"}, {"s": 71.085, "e": 71.765, "t": "piring,"}, {"s": 71.792, "e": 72.565, "t": "ya sama aja,"}, {"s": 72.625, "e": 72.885, "t": "kak."}, {"s": 73.725, "e": 75.125, "t": "Terus ada bahayanya juga."}, {"s": 75.325, "e": 76.805, "t": "Nasi bisa membawa spora"}, {"s": 76.865, "e": 78.325, "t": "bakteri Bacillus cereus yang"}, {"s": 78.405, "e": 79.525, "t": "tahan dimasak."}, {"s": 79.605, "e": 80.885, "t": "Kalau nasi dibiarkan di"}, {"s": 80.938, "e": 82.325, "t": "suhu ruang berjam-jam,"}, {"s": 82.385, "e": 83.685, "t": "bakteri ini bisa tumbuh"}, {"s": 83.745, "e": 84.805, "t": "dan bikin racun."}, {"s": 84.965, "e": 86.645, "t": "Racunnya nggak hilang walaupun"}, {"s": 86.685, "e": 88.165, "t": "nasinya dipanaskan lagi."}, {"s": 88.352, "e": 89.925, "t": "Akibatnya mual,"}, {"s": 89.965, "e": 90.805, "t": "muntah,"}, {"s": 90.845, "e": 91.525, "t": "dan diare."}, {"s": 92.459, "e": 93.445, "t": "Plot twist-nya..."}, {"s": 93.477, "e": 94.485, "t": "yang bikin nasi sisa"}, {"s": 94.525, "e": 95.525, "t": "lebih sehat itu bukan"}, {"s": 95.585, "e": 96.405, "t": "sisanya,"}, {"s": 96.469, "e": 97.525, "t": "tapi kulkasnya!"}, {"s": 97.805, "e": 99.445, "t": "Nasi yang ditinggal semalaman"}, {"s": 99.472, "e": 100.725, "t": "di meja justru paling"}, {"s": 100.765, "e": 101.365, "t": "berisiko."}, {"s": 102.235, "e": 103.605, "t": "Jadi caranya gini."}, {"s": 103.669, "e": 105.365, "t": "Dinginkan nasi maksimal satu"}, {"s": 105.425, "e": 106.645, "t": "jam setelah matang,"}, {"s": 106.705, "e": 107.965, "t": "simpan di kulkas,"}, {"s": 108.015, "e": 109.525, "t": "habiskan dalam sehari,"}, {"s": 109.565, "e": 111.405, "t": "lalu panaskan sampai benar-benar"}, {"s": 111.435, "e": 112.005, "t": "panas,"}, {"s": 112.065, "e": 113.525, "t": "cukup sekali aja."}, {"s": 114.205, "e": 115.205, "t": "Kamu tim nasi anget"}, {"s": 115.253, "e": 116.405, "t": "atau tim nasi kulkas,"}, {"s": 116.445, "e": 116.645, "t": "kak?"}, {"s": 116.785, "e": 118.325, "t": "Tulis di komentar ya!"}]