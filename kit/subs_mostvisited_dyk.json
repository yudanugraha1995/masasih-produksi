[{"s": 0, "e": 0.931, "t": "What if your country"}, {"s": 0.931, "e": 1.955, "t": "got a hundred million"}, {"s": 1.955, "e": 3.606, "t": "tourists a year?"}, {"s": 3.606, "e": 5.083, "t": "Let's count."}, {"s": 5.083, "e": 6.193, "t": "Australia:"}, {"s": 6.193, "e": 7.857, "t": "about seven million visitors,"}, {"s": 7.857, "e": 8.838, "t": "mostly from New Zealand"}, {"s": 8.838, "e": 10.262, "t": "and China."}, {"s": 10.262, "e": 11.03, "t": "Turkey:"}, {"s": 11.03, "e": 12.651, "t": "about fifty five million,"}, {"s": 12.651, "e": 14.763, "t": "many heading to Istanbul."}, {"s": 14.763, "e": 15.573, "t": "Italy:"}, {"s": 15.573, "e": 17.067, "t": "about fifty seven million,"}, {"s": 17.067, "e": 17.835, "t": "for pizza,"}, {"s": 17.835, "e": 19.809, "t": "pasta and Rome."}, {"s": 19.809, "e": 20.705, "t": "America:"}, {"s": 20.705, "e": 22.198, "t": "about sixty six million,"}, {"s": 22.198, "e": 23.009, "t": "with New York and"}, {"s": 23.009, "e": 24.895, "t": "Florida on top."}, {"s": 24.895, "e": 25.791, "t": "Spain:"}, {"s": 25.791, "e": 27.369, "t": "about eighty five million,"}, {"s": 27.369, "e": 28.564, "t": "more tourists than people"}, {"s": 28.564, "e": 29.928, "t": "living there!"}, {"s": 29.928, "e": 31.678, "t": "But here's the twist."}, {"s": 31.678, "e": 32.617, "t": "France:"}, {"s": 32.617, "e": 33.726, "t": "about one hundred million"}, {"s": 33.726, "e": 34.494, "t": "tourists,"}, {"s": 34.494, "e": 35.646, "t": "the most visited country"}, {"s": 35.646, "e": 36.457, "t": "on Earth,"}, {"s": 36.457, "e": 37.395, "t": "and the Louvre is"}, {"s": 37.395, "e": 39.587, "t": "the most visited museum!"}, {"s": 39.587, "e": 40.355, "t": "Which country would you"}, {"s": 40.355, "e": 41.948, "t": "visit first?"}, {"s": 41.948, "e": 42.972, "t": "Comment below,"}, {"s": 42.972, "e": 44.209, "t": "and subscribe for more!"}]