[{"s": 0, "e": 0.931, "t": "Is it soccer or"}, {"s": 0.931, "e": 2.327, "t": "football?"}, {"s": 2.327, "e": 4.413, "t": "The world can't agree."}, {"s": 4.413, "e": 5.309, "t": "America:"}, {"s": 5.309, "e": 5.778, "t": "soccer,"}, {"s": 5.778, "e": 6.802, "t": "because football means the"}, {"s": 6.802, "e": 7.527, "t": "NFL,"}, {"s": 7.527, "e": 9.791, "t": "with helmets and touchdowns!"}, {"s": 9.791, "e": 10.729, "t": "Australia:"}, {"s": 10.729, "e": 11.54, "t": "soccer too,"}, {"s": 11.54, "e": 12.82, "t": "since footy usually means"}, {"s": 12.82, "e": 14.1, "t": "Aussie rules or rugby"}, {"s": 14.1, "e": 15.259, "t": "league."}, {"s": 15.259, "e": 16.241, "t": "The UK:"}, {"s": 16.241, "e": 16.966, "t": "football,"}, {"s": 16.966, "e": 17.947, "t": "and the word soccer"}, {"s": 17.947, "e": 19.227, "t": "actually started there,"}, {"s": 19.227, "e": 20.678, "t": "as slang for association"}, {"s": 20.678, "e": 21.925, "t": "football!"}, {"s": 21.925, "e": 22.992, "t": "Brazil:"}, {"s": 22.992, "e": 23.973, "t": "futebol,"}, {"s": 23.973, "e": 24.997, "t": "and they've won five"}, {"s": 24.997, "e": 26.61, "t": "World Cups."}, {"s": 26.61, "e": 27.421, "t": "Spain:"}, {"s": 27.421, "e": 28.189, "t": "fútbol,"}, {"s": 28.189, "e": 29.255, "t": "home of Real Madrid"}, {"s": 29.255, "e": 30.322, "t": "and Barcelona,"}, {"s": 30.322, "e": 31.047, "t": "two of the biggest"}, {"s": 31.047, "e": 32.63, "t": "clubs on Earth."}, {"s": 32.63, "e": 34.373, "t": "But here's the twist."}, {"s": 34.373, "e": 35.183, "t": "Italy:"}, {"s": 35.183, "e": 36.463, "t": "they call it calcio,"}, {"s": 36.463, "e": 37.743, "t": "which means kick,"}, {"s": 37.743, "e": 38.682, "t": "named after an old"}, {"s": 38.682, "e": 39.919, "t": "Florence game with almost"}, {"s": 39.919, "e": 41.457, "t": "no rules!"}, {"s": 41.457, "e": 42.011, "t": "What do you call"}, {"s": 42.011, "e": 43.107, "t": "it?"}, {"s": 43.107, "e": 44.003, "t": "Comment below,"}, {"s": 44.003, "e": 45.368, "t": "and subscribe for more!"}]