[{"s": 0, "e": 1.102, "t": "What if summer break"}, {"s": 1.102, "e": 3.1, "t": "lasted three months?"}, {"s": 3.1, "e": 4.673, "t": "Let's compare."}, {"s": 4.673, "e": 5.783, "t": "Australia:"}, {"s": 5.783, "e": 6.764, "t": "about six weeks,"}, {"s": 6.764, "e": 7.745, "t": "over Christmas,"}, {"s": 7.745, "e": 9.459, "t": "because it's summer there!"}, {"s": 9.459, "e": 10.441, "t": "The UK:"}, {"s": 10.441, "e": 11.507, "t": "about six weeks,"}, {"s": 11.507, "e": 12.617, "t": "from late July to"}, {"s": 12.617, "e": 14.202, "t": "early September."}, {"s": 14.202, "e": 15.183, "t": "Japan:"}, {"s": 15.183, "e": 16.122, "t": "about six weeks,"}, {"s": 16.122, "e": 17.146, "t": "from late July,"}, {"s": 17.146, "e": 17.957, "t": "but kids still get"}, {"s": 17.957, "e": 19.585, "t": "a lot of homework."}, {"s": 19.585, "e": 20.524, "t": "Germany:"}, {"s": 20.524, "e": 21.335, "t": "six weeks,"}, {"s": 21.335, "e": 22.401, "t": "and each state starts"}, {"s": 22.401, "e": 23.34, "t": "at a different time"}, {"s": 23.34, "e": 24.279, "t": "so the highways don't"}, {"s": 24.279, "e": 25.563, "t": "jam."}, {"s": 25.563, "e": 26.545, "t": "America:"}, {"s": 26.545, "e": 27.654, "t": "around ten to eleven"}, {"s": 27.654, "e": 28.123, "t": "weeks,"}, {"s": 28.123, "e": 29.859, "t": "depending on the state!"}, {"s": 29.859, "e": 31.502, "t": "Think that's long?"}, {"s": 31.502, "e": 33.102, "t": "Here's the twist."}, {"s": 33.102, "e": 33.998, "t": "Italy:"}, {"s": 33.998, "e": 35.278, "t": "about thirteen weeks,"}, {"s": 35.278, "e": 36.089, "t": "from mid June to"}, {"s": 36.089, "e": 37.155, "t": "mid September,"}, {"s": 37.155, "e": 37.966, "t": "one of the longest"}, {"s": 37.966, "e": 39.885, "t": "summer breaks in Europe!"}, {"s": 39.885, "e": 40.482, "t": "How long is your"}, {"s": 40.482, "e": 41.964, "t": "summer break?"}, {"s": 41.964, "e": 42.775, "t": "Comment below,"}, {"s": 42.775, "e": 44.012, "t": "and subscribe for more!"}]