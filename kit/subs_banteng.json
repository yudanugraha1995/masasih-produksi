[{"s": 0.136, "e": 1.52, "t": "Katanya banteng langsung ngamuk"}, {"s": 1.58, "e": 2.72, "t": "kalau lihat warna merah!"}, {"s": 3.209, "e": 3.849, "t": "Masa sih?"}, {"s": 4.249, "e": 5.369, "t": "Faktanya,"}, {"s": 5.409, "e": 6.729, "t": "banteng itu buta warna"}, {"s": 6.769, "e": 7.369, "t": "merah,"}, {"s": 7.409, "e": 8.569, "t": "jadi kain merah kelihatan"}, {"s": 8.633, "e": 9.849, "t": "biasa aja buat dia."}, {"s": 10.623, "e": 11.529, "t": "Plot twist-nya,"}, {"s": 11.561, "e": 12.729, "t": "yang bikin banteng nyeruduk"}, {"s": 12.829, "e": 14.169, "t": "itu gerakan kainnya yang"}, {"s": 14.209, "e": 15.05, "t": "dikibas-kibas."}, {"s": 15.249, "e": 16.649, "t": "Warna apa pun tetap"}, {"s": 16.702, "e": 17.289, "t": "dikejar!"}, {"s": 18.075, "e": 19.055, "t": "Kamu tim berani lawan"}, {"s": 19.095, "e": 20.335, "t": "banteng atau tim kabur"}, {"s": 20.395, "e": 20.895, "t": "duluan?"}, {"s": 21.015, "e": 22.335, "t": "Tulis di komentar!"}]