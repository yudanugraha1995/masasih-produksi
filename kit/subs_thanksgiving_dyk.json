[{"s": 0, "e": 1.315, "t": "What if Thanksgiving happened"}, {"s": 1.315, "e": 2.297, "t": "on a totally different"}, {"s": 2.297, "e": 3.469, "t": "day?"}, {"s": 3.469, "e": 4.28, "t": "Let's check around the"}, {"s": 4.28, "e": 5.469, "t": "world."}, {"s": 5.469, "e": 6.279, "t": "Canada:"}, {"s": 6.279, "e": 7.218, "t": "the second Monday of"}, {"s": 7.218, "e": 8.029, "t": "October,"}, {"s": 8.029, "e": 8.797, "t": "more than a month"}, {"s": 8.797, "e": 10.244, "t": "earlier!"}, {"s": 10.244, "e": 11.055, "t": "Germany:"}, {"s": 11.055, "e": 12.42, "t": "a harvest festival called"}, {"s": 12.42, "e": 13.487, "t": "Erntedankfest,"}, {"s": 13.487, "e": 15.873, "t": "in early October."}, {"s": 15.873, "e": 16.939, "t": "South Korea:"}, {"s": 16.939, "e": 17.75, "t": "Chuseok,"}, {"s": 17.75, "e": 18.731, "t": "a three day harvest"}, {"s": 18.731, "e": 20.054, "t": "holiday when families travel"}, {"s": 20.054, "e": 21.2, "t": "home."}, {"s": 21.2, "e": 22.181, "t": "Japan:"}, {"s": 22.181, "e": 23.803, "t": "Labor Thanksgiving Day,"}, {"s": 23.803, "e": 25.211, "t": "every November twenty third,"}, {"s": 25.211, "e": 26.961, "t": "to thank workers."}, {"s": 26.961, "e": 27.985, "t": "Australia:"}, {"s": 27.985, "e": 29.649, "t": "on tiny Norfolk Island,"}, {"s": 29.649, "e": 31.185, "t": "people celebrate an American"}, {"s": 31.185, "e": 32.337, "t": "style Thanksgiving,"}, {"s": 32.337, "e": 34.463, "t": "thanks to visiting whalers!"}, {"s": 34.463, "e": 36.457, "t": "But here's the twist."}, {"s": 36.457, "e": 37.311, "t": "America:"}, {"s": 37.311, "e": 38.335, "t": "the fourth Thursday of"}, {"s": 38.335, "e": 39.103, "t": "November,"}, {"s": 39.103, "e": 40.297, "t": "when Americans eat about"}, {"s": 40.297, "e": 41.833, "t": "forty six million turkeys"}, {"s": 41.833, "e": 43.817, "t": "in a single day!"}, {"s": 43.817, "e": 44.457, "t": "When do you give"}, {"s": 44.457, "e": 45.761, "t": "thanks?"}, {"s": 45.761, "e": 46.699, "t": "Comment below,"}, {"s": 46.699, "e": 48.022, "t": "and subscribe for more!"}]