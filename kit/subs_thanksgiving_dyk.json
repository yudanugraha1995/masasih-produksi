[{"s": 0, "e": 1.315, "t": "What if Thanksgiving happened"}, {"s": 1.315, "e": 2.339, "t": "on a totally different"}, {"s": 2.339, "e": 3.408, "t": "day?"}, {"s": 3.408, "e": 4.861, "t": "Let's check."}, {"s": 4.861, "e": 5.714, "t": "America:"}, {"s": 5.714, "e": 6.696, "t": "the fourth Thursday of"}, {"s": 6.696, "e": 7.976, "t": "November,"}, {"s": 7.976, "e": 9.961, "t": "with turkey and football."}, {"s": 9.961, "e": 10.729, "t": "Canada:"}, {"s": 10.729, "e": 11.625, "t": "the second Monday of"}, {"s": 11.625, "e": 13.088, "t": "October!"}, {"s": 13.088, "e": 13.856, "t": "Germany:"}, {"s": 13.856, "e": 15.221, "t": "a harvest festival called"}, {"s": 15.221, "e": 16.202, "t": "Erntedankfest,"}, {"s": 16.202, "e": 18.753, "t": "in early October."}, {"s": 18.753, "e": 20.745, "t": "South Korea:"}, {"s": 20.745, "e": 21.215, "t": "Chuseok,"}, {"s": 21.215, "e": 22.942, "t": "a three day harvest"}, {"s": 22.942, "e": 24.251, "t": "holiday."}, {"s": 24.251, "e": 25.232, "t": "Japan:"}, {"s": 25.232, "e": 26.683, "t": "Labor Thanksgiving Day,"}, {"s": 26.683, "e": 29.393, "t": "every November twenty third."}, {"s": 29.393, "e": 31.084, "t": "But here's the twist."}, {"s": 31.084, "e": 32.065, "t": "Australia:"}, {"s": 32.065, "e": 34.365, "t": "on tiny Norfolk Island,"}, {"s": 34.365, "e": 35.773, "t": "people celebrate an American"}, {"s": 35.773, "e": 37.464, "t": "style Thanksgiving,"}, {"s": 37.464, "e": 39.628, "t": "thanks to American whalers!"}, {"s": 39.628, "e": 40.183, "t": "When do you give"}, {"s": 40.183, "e": 41.38, "t": "thanks?"}, {"s": 41.38, "e": 42.897, "t": "Comment below,"}, {"s": 42.897, "e": 43.92, "t": "and subscribe!"}]