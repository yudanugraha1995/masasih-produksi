[{"s": 0.12, "e": 0.64, "t": "Woyyy!"}, {"s": 0.72, "e": 1.84, "t": "Katanya ikan mas cuma"}, {"s": 1.888, "e": 3.2, "t": "bisa ingat tiga detik!"}, {"s": 3.51, "e": 4.399, "t": "Masa sih?"}, {"s": 4.448, "e": 5.208, "t": "Yuk kita cek!"}, {"s": 5.32, "e": 7.048, "t": "Para ilmuwan sudah menguji"}, {"s": 7.088, "e": 8.408, "t": "ingatan ikan mas."}, {"s": 8.448, "e": 10.008, "t": "Dalam beberapa percobaan,"}, {"s": 10.088, "e": 11.448, "t": "ikan dilatih mendorong tuas"}, {"s": 11.496, "e": 12.408, "t": "atau berenang ke tempat"}, {"s": 12.456, "e": 14.328, "t": "tertentu untuk dapat makanan."}, {"s": 14.428, "e": 15.368, "t": "Hasilnya,"}, {"s": 15.408, "e": 16.488, "t": "ikan mas bisa mengingat"}, {"s": 16.528, "e": 18.728, "t": "pelajaran itu selama berminggu-minggu,"}, {"s": 18.788, "e": 20.328, "t": "bahkan berbulan-bulan."}, {"s": 20.408, "e": 21.368, "t": "Ada juga ikan yang"}, {"s": 21.408, "e": 22.968, "t": "dilatih merespons bunyi tertentu"}, {"s": 23.032, "e": 24.168, "t": "saat jam makan,"}, {"s": 24.208, "e": 25.368, "t": "dan masih ingat beberapa"}, {"s": 25.428, "e": 26.648, "t": "bulan kemudian."}, {"s": 26.768, "e": 27.768, "t": "Ikan mas juga bisa"}, {"s": 27.808, "e": 29.128, "t": "membedakan warna,"}, {"s": 29.176, "e": 29.768, "t": "bentuk,"}, {"s": 29.828, "e": 30.888, "t": "bahkan wajah orang yang"}, {"s": 30.952, "e": 32.568, "t": "biasa memberinya makan."}, {"s": 33.016, "e": 33.928, "t": "Plot twist-nya..."}, {"s": 33.948, "e": 35.168, "t": "ingatan ikan mas jauh"}, {"s": 35.188, "e": 36.168, "t": "lebih panjang dari tiga"}, {"s": 36.228, "e": 36.808, "t": "detik,"}, {"s": 36.868, "e": 38.968, "t": "malah bisa sampai berbulan-bulan!"}, {"s": 39.128, "e": 40.488, "t": "Jadi kalau pelihara ikan"}, {"s": 40.568, "e": 41.048, "t": "mas,"}, {"s": 41.108, "e": 42.008, "t": "kasih makan di jam"}, {"s": 42.04, "e": 42.888, "t": "yang sama,"}, {"s": 42.928, "e": 44.168, "t": "jangan terlalu banyak,"}, {"s": 44.208, "e": 45.448, "t": "dan rajin ganti