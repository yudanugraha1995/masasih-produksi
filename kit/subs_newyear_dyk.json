[{"s": 0, "e": 0.974, "t": "What if New Year's"}, {"s": 0.974, "e": 3.469, "t": "Eve meant smashing plates?"}, {"s": 3.469, "e": 4.237, "t": "Let's look around the"}, {"s": 4.237, "e": 5.373, "t": "world."}, {"s": 5.373, "e": 6.397, "t": "Australia:"}, {"s": 6.397, "e": 7.805, "t": "huge fireworks over Sydney"}, {"s": 7.805, "e": 8.531, "t": "Harbour,"}, {"s": 8.531, "e": 9.171, "t": "one of the first"}, {"s": 9.171, "e": 10.152, "t": "big cities to welcome"}, {"s": 10.152, "e": 11.667, "t": "the new year."}, {"s": 11.667, "e": 12.478, "t": "Spain:"}, {"s": 12.478, "e": 13.673, "t": "eat twelve grapes,"}, {"s": 13.673, "e": 14.441, "t": "one for every bell"}, {"s": 14.441, "e": 15.948, "t": "at midnight!"}, {"s": 15.948, "e": 16.929, "t": "Japan:"}, {"s": 16.929, "e": 18.167, "t": "temple bells ring one"}, {"s": 18.167, "e": 20.175, "t": "hundred and eight times."}, {"s": 20.175, "e": 21.071, "t": "Brazil:"}, {"s": 21.071, "e": 22.138, "t": "wear white and jump"}, {"s": 22.138, "e": 23.119, "t": "over seven waves for"}, {"s": 23.119, "e": 24.28, "t": "luck."}, {"s": 24.28, "e": 25.091, "t": "Denmark:"}, {"s": 25.091, "e": 26.413, "t": "people smash old plates"}, {"s": 26.413, "e": 27.352, "t": "on their friends' doors"}, {"s": 27.352, "e": 28.861, "t": "for good luck!"}, {"s": 28.861, "e": 30.722, "t": "But here's the twist."}, {"s": 30.722, "e": 31.533, "t": "America:"}, {"s": 31.533, "e": 32.599, "t": "the Times Square ball"}, {"s": 32.599, "e": 33.879, "t": "has dropped since nineteen"}, {"s": 33.879, "e": 34.733, "t": "oh seven,"}, {"s": 34.733, "e": 35.714, "t": "and so many people"}, {"s": 35.714, "e": 36.695, "t": "pack the streets that"}, {"s": 36.695, "e": 38.274, "t": "some wear adult diapers,"}, {"s": 38.274, "e": 38.871, "t": "because there are no"}, {"s": 38.871, "e": 40.363, "t": "bathrooms!"}, {"s": 40.363, "e": 42.076, "t": "How do you celebrate?"}, {"s": 42.076, "e": 43.015, "t": "Comment below,"}, {"s": 43.015, "e": 44.38, "t": "and subscribe for more!"}]