[{"s": 0.12, "e": 0.64, "t": "Woyyy!"}, {"s": 0.68, "e": 1.84, "t": "Makan telur dua biji"}, {"s": 1.867, "e": 2.96, "t": "langsung dimarahin,"}, {"s": 3.04, "e": 4.0, "t": "awas bisulan!"}, {"s": 4.71, "e": 5.28, "t": "Masa sih?"}, {"s": 5.806, "e": 6.566, "t": "Yuk kita cek!"}, {"s": 6.786, "e": 8.566, "t": "Bisul itu infeksi di"}, {"s": 8.619, "e": 9.846, "t": "akar rambut atau kelenjar"}, {"s": 9.886, "e": 10.726, "t": "minyak kulit."}, {"s": 10.766, "e": 12.966, "t": "Pelaku utamanya bakteri Staphylococcus"}, {"s": 13.03, "e": 13.606, "t": "aureus."}, {"s": 13.766, "e": 15.286, "t": "Bakteri ini masuk lewat"}, {"s": 15.326, "e": 16.166, "t": "luka kecil,"}, {"s": 16.226, "e": 17.286, "t": "bekas garukan,"}, {"s": 17.35, "e": 18.406, "t": "atau kulit yang lembap"}, {"s": 18.446, "e": 19.286, "t": "dan kotor."}, {"s": 19.386, "e": 20.806, "t": "Telur nggak membawa bakteri"}, {"s": 20.866, "e": 22.166, "t": "itu ke kulit kamu."}, {"s": 22.266, "e": 23.366, "t": "Dokter sepakat,"}, {"s": 23.406, "e": 24.566, "t": "belum ada bukti ilmiah"}, {"s": 24.626, "e": 26.006, "t": "telur bikin bisulan pada"}, {"s": 26.046, "e": 26.806, "t": "orang sehat."}, {"s": 26.906, "e": 28.166, "t": "Terus kenapa mitos ini"}, {"s": 28.246, "e": 28.646, "t": "awet?"}, {"s": 28.859, "e": 30.246, "t": "Orang yang alergi telur"}, {"s": 30.294, "e": 31.686, "t": "bisa muncul benjolan gatal"}, {"s": 31.718, "e": 32.806, "t": "yang mirip bisul."}, {"s": 32.886, "e": 33.926, "t": "Kalau digaruk,"}, {"s": 33.966, "e": 34.886, "t": "kulitnya luka,"}, {"s": 34.926, "e": 36.646, "t": "lalu bakteri gampang masuk."}, {"s": 37.01, "e": 37.938, "t": "Plot twist-nya..."}, {"s": 37.978, "e": 39.218, "t": "telur malah sumber protein"}, {"s": 39.266, "e": 40.418, "t": "yang bantu luka cepat"}, {"s": 40.458, "e": 40.818, "t": "sembuh!"}, {"s": 40.998, "e": 42.578, "t": "Satu butir telur punya"}, {"s": 42.631, "e": 44.418, "t": "sekitar enam gram protein."}, {"s": 44.482, "e": 45.778, "t": "Yang perlu dijaga itu"}, {"s": 45.805, "e": 46.978, "t": "kebersihan kulit."}, {"s": 47.058, "e": 48.058, "t": "Ganti baju yang basah"}, {"s": 48.078, "e": 48.818, "t": "keringat,"}, {"s": 48.858, "e": 50.098, "t": "jangan pencet bisul,"}, {"s": 50.138, "e": 51.618, "t": "dan kalau punya diabetes,"}, {"s": 51.698, "e": 53.058, "t": "rajin cek gula darah,"}, {"s": 53.104, "e": 54.338, "t": "karena lebih gampang kena"}, {"s": 54.398, "e": 55.378, "t": "infeksi kulit."}, {"s": 55.908, "e": 56.738, "t": "Kamu tim telur tiap"}, {"s": 56.802, "e": 57.858, "t": "hari atau tim takut"}, {"s": 57.898, "e": 58.418, "t": "bisulan,"}, {"s": 58.438, "e": 58.898, "t": "kak?"}, {"s": 58.938, "e": 60.098, "t": "Tulis di komentar ya!"}]