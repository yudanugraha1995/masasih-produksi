[{"s": 0, "e": 1.059, "t": "What if coffee ran"}, {"s": 1.059, "e": 2.854, "t": "your whole country?"}, {"s": 2.854, "e": 4.553, "t": "Let's compare."}, {"s": 4.553, "e": 5.406, "t": "Finland:"}, {"s": 5.406, "e": 6.601, "t": "about twelve kilos per"}, {"s": 6.601, "e": 7.582, "t": "person a year,"}, {"s": 7.582, "e": 8.734, "t": "the biggest coffee drinkers"}, {"s": 8.734, "e": 9.502, "t": "on Earth,"}, {"s": 9.502, "e": 10.654, "t": "with coffee breaks written"}, {"s": 10.654, "e": 12.641, "t": "into work contracts!"}, {"s": 12.641, "e": 13.452, "t": "Italy:"}, {"s": 13.452, "e": 14.732, "t": "drinking your espresso standing"}, {"s": 14.732, "e": 15.543, "t": "at the bar is"}, {"s": 15.543, "e": 16.695, "t": "often cheaper than sitting"}, {"s": 16.695, "e": 17.851, "t": "down."}, {"s": 17.851, "e": 18.79, "t": "Japan:"}, {"s": 18.79, "e": 19.515, "t": "you can buy hot"}, {"s": 19.515, "e": 20.582, "t": "canned coffee from vending"}, {"s": 20.582, "e": 22.033, "t": "machines on almost any"}, {"s": 22.033, "e": 23.187, "t": "street."}, {"s": 23.187, "e": 24.083, "t": "Brazil:"}, {"s": 24.083, "e": 24.979, "t": "grows about a third"}, {"s": 24.979, "e": 25.747, "t": "of all the world's"}, {"s": 25.747, "e": 26.966, "t": "coffee."}, {"s": 26.966, "e": 28.033, "t": "Australia:"}, {"s": 28.033, "e": 28.929, "t": "still argues with New"}, {"s": 28.929, "e": 30.081, "t": "Zealand over who invented"}, {"s": 30.081, "e": 31.719, "t": "the flat white!"}, {"s": 31.719, "e": 33.608, "t": "But here's the twist."}, {"s": 33.608, "e": 34.419, "t": "America:"}, {"s": 34.419, "e": 35.315, "t": "drinks the most coffee"}, {"s": 35.315, "e": 36.083, "t": "in total,"}, {"s": 36.083, "e": 37.192, "t": "about four hundred million"}, {"s": 37.192, "e": 39.219, "t": "cups every single day!"}, {"s": 39.219, "e": 39.944, "t": "How many cups do"}, {"s": 39.944, "e": 41.563, "t": "you drink a day?"}, {"s": 41.563, "e": 42.545, "t": "Comment below,"}, {"s": 42.545, "e": 43.782, "t": "and subscribe for more!"}]