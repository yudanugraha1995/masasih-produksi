[{"s": 0, "e": 0.846, "t": "What if you drank"}, {"s": 0.846, "e": 2.97, "t": "tea all day long?"}, {"s": 2.97, "e": 4.037, "t": "Let's compare tea per"}, {"s": 4.037, "e": 5.431, "t": "person."}, {"s": 5.431, "e": 6.071, "t": "America:"}, {"s": 6.071, "e": 6.967, "t": "about a quarter kilo"}, {"s": 6.967, "e": 7.607, "t": "a year,"}, {"s": 7.607, "e": 8.375, "t": "and most of it"}, {"s": 8.375, "e": 10.033, "t": "is iced tea!"}, {"s": 10.033, "e": 10.801, "t": "Australia:"}, {"s": 10.801, "e": 11.739, "t": "about three quarters of"}, {"s": 11.739, "e": 13.111, "t": "a kilo."}, {"s": 13.111, "e": 13.921, "t": "Japan:"}, {"s": 13.921, "e": 14.817, "t": "about one kilo,"}, {"s": 14.817, "e": 15.969, "t": "mostly green tea,"}, {"s": 15.969, "e": 16.609, "t": "and it even has"}, {"s": 16.609, "e": 18.639, "t": "a whole tea ceremony."}, {"s": 18.639, "e": 19.492, "t": "The UK:"}, {"s": 19.492, "e": 20.644, "t": "almost two kilos,"}, {"s": 20.644, "e": 21.753, "t": "about one hundred million"}, {"s": 21.753, "e": 23.906, "t": "cups every single day!"}, {"s": 23.906, "e": 24.589, "t": "Ireland:"}, {"s": 24.589, "e": 25.527, "t": "about two point two"}, {"s": 25.527, "e": 26.167, "t": "kilos,"}, {"s": 26.167, "e": 26.722, "t": "even more than the"}, {"s": 26.722, "e": 28.064, "t": "UK!"}, {"s": 28.064, "e": 29.804, "t": "But here's the twist."}, {"s": 29.804, "e": 30.572, "t": "Turkey:"}, {"s": 30.572, "e": 31.596, "t": "over three kilos per"}, {"s": 31.596, "e": 32.236, "t": "person,"}, {"s": 32.236, "e": 33.26, "t": "the biggest tea drinkers"}, {"s": 33.26, "e": 34.113, "t": "on Earth,"}, {"s": 34.113, "e": 35.095, "t": "served in little tulip"}, {"s": 35.095, "e": 36.812, "t": "shaped glasses!"}, {"s": 36.812, "e": 38.728, "t": "Tea or coffee?"}, {"s": 38.728, "e": 39.539, "t": "Comment below,"}, {"s": 39.539, "e": 40.776, "t": "and subscribe for more!"}]