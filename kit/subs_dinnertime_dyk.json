[{"s": 0, "e": 0.889, "t": "What if dinner started"}, {"s": 0.889, "e": 2.536, "t": "at ten at night?"}, {"s": 2.536, "e": 4.373, "t": "Let's check the clock."}, {"s": 4.373, "e": 5.226, "t": "America:"}, {"s": 5.226, "e": 6.421, "t": "around six PM,"}, {"s": 6.421, "e": 7.701, "t": "sometimes even earlier with"}, {"s": 7.701, "e": 8.298, "t": "kids,"}, {"s": 8.298, "e": 9.493, "t": "and lots of restaurants"}, {"s": 9.493, "e": 11.887, "t": "offer early bird specials!"}, {"s": 11.887, "e": 12.996, "t": "Australia:"}, {"s": 12.996, "e": 14.063, "t": "around six thirty,"}, {"s": 14.063, "e": 14.831, "t": "and they often call"}, {"s": 14.831, "e": 16.203, "t": "it tea!"}, {"s": 16.203, "e": 17.227, "t": "The UK:"}, {"s": 17.227, "e": 18.081, "t": "around seven,"}, {"s": 18.081, "e": 18.678, "t": "and in the north"}, {"s": 18.678, "e": 20.778, "t": "it's also called tea."}, {"s": 20.778, "e": 21.717, "t": "Germany:"}, {"s": 21.717, "e": 22.613, "t": "Abendbrot,"}, {"s": 22.613, "e": 23.679, "t": "a cold bread dinner"}, {"s": 23.679, "e": 24.831, "t": "around six or seven,"}, {"s": 24.831, "e": 25.642, "t": "since lunch is the"}, {"s": 25.642, "e": 26.972, "t": "big meal."}, {"s": 26.972, "e": 27.74, "t": "Italy:"}, {"s": 27.74, "e": 28.764, "t": "around eight thirty,"}, {"s": 28.764, "e": 29.916, "t": "after an aperitivo with"}, {"s": 29.916, "e": 31.174, "t": "friends."}, {"s": 31.174, "e": 33.027, "t": "But here's the twist."}, {"s": 33.027, "e": 33.88, "t": "Spain:"}, {"s": 33.88, "e": 35.075, "t": "dinner often starts at"}, {"s": 35.075, "e": 35.757, "t": "ten PM,"}, {"s": 35.757, "e": 36.867, "t": "or even later,"}, {"s": 36.867, "e": 38.104, "t": "partly because Spain uses"}, {"s": 38.104, "e": 38.915, "t": "a time zone that's"}, {"s": 38.915, "e": 39.725, "t": "an hour ahead of"}, {"s": 39.725, "e": 41.102, "t": "the sun!"}, {"s": 41.102, "e": 41.571, "t": "When do you eat"}, {"s": 41.571, "e": 42.793, "t": "dinner?"}, {"s": 42.793, "e": 43.731, "t": "Comment below,"}, {"s": 43.731, "e": 45.096, "t": "and subscribe for more!"}]