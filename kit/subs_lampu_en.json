[{"s": 0.0, "e": 0.56, "t": "Yo!"}, {"s": 1.18, "e": 2.32, "t": "It's already midnight,"}, {"s": 2.38, "e": 3.2, "t": "but your room is"}, {"s": 3.2, "e": 4.04, "t": "still as bright as"}, {"s": 4.04, "e": 4.92, "t": "a convenience store."}, {"s": 5.12, "e": 5.66, "t": "If you sleep with"}, {"s": 5.66, "e": 6.56, "t": "the lights on every"}, {"s": 6.56, "e": 6.88, "t": "night,"}, {"s": 7.04, "e": 7.84, "t": "does your body get"}, {"s": 7.84, "e": 8.5, "t": "confused too?"}, {"s": 8.68, "e": 9.38, "t": "Light is a cue"}, {"s": 9.38, "e": 10.24, "t": "for your body clock."}, {"s": 10.48, "e": 11.56, "t": "Bright light before bed"}, {"s": 11.56, "e": 13.0, "t": "can suppress melatonin,"}, {"s": 13.14, "e": 13.96, "t": "the hormone that helps"}, {"s": 13.96, "e": 14.68, "t": "signal nighttime."}, {"s": 15.02, "e": 15.62, "t": "As a result,"}, {"s": 15.76, "e": 16.78, "t": "your sleepy signal can"}, {"s": 16.78, "e": 17.14, "t": "shift,"}, {"s": 17.38, "e": 18.12, "t": "and your sleep can"}, {"s": 18.12, "e": 18.72, "t": "get disrupted."}, {"s": 19.04, "e": 19.78, "t": "It's not just about"}, {"s": 19.78, "e": 20.2, "t": "the glare."}, {"s": 20.52, "e": 21.0, "t": "Plot twist!"}, {"s": 21.32, "e": 22.22, "t": "feeling like you slept"}, {"s": 22.22, "e": 23.54, "t": "deeply doesn't mean your"}, {"s": 23.54, "e": 24.72, "t": "body ignored the light."}, {"s": 24.9, "e": 25.84, "t": "A small study found"}, {"s": 25.84, "e": 26.8, "t": "a higher heart rate"}, {"s": 26.8, "e": 27.64, "t": "while sleeping with the"}, {"s": 27.64, "e": 28.16, "t": "lights on,"}, {"s": 28.16, "e": 29.42, "t": "and a changed insulin"}, {"s": 29.42, "e": 30.68, "t": "response the next morning."}, {"s": 30.92, "e": 31.68, "t": "But that's not proof"}, {"s": 31.68, "e": 32.74, "t": "that one bright night"}, {"s": 32.74, "e": 33.6, "t": "gives you diabetes."}, {"s": 34.06, "e": 35.28, "t": "The long-term effects still"}, {"s": 35.28, "e": 36.1, "t": "need more research."}, {"s": 36.4, "e": 37.26, "t": "Try dimming the lights"}, {"s": 37.26, "e": 37.9, "t": "before bed,"}, {"s": 38.06, "e": 38.76, "t": "then make your room"}, {"s": 38.76, "e": 39.7, "t": "dark when you sleep."}, {"s": 39.9, "e": 40.42, "t": "If you need some"}, {"s": 40.42, "e": 41.22, "t": "light for safety,"}, {"s": 41.42, "e": 42.2, "t": "pick a dim light"}, {"s": 42.2, "e": 42.9, "t": "near the floor,"}, {"s": 43.12, "e": 44.04, "t": "not one shining on"}, {"s": 44.04, "e": 44.44, "t": "your face."}, {"s": 44.76, "e": 45.28, "t": "What about you?"}, {"s": 45.42, "e": 46.06, "t": "Do you sleep better"}, {"s": 46.06, "e": 46.86, "t": "in the dark or"}, {"s": 46.86, "e": 47.82, "t": "with a little night light?"}, {"s": 47.96, "e": 48.42, "t": "Tell us in the"}, {"s": 48.42, "e": 48.78, "t": "comments!"}]