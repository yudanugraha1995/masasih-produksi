[{"s": 0, "e": 1.315, "t": "What if pennies just"}, {"s": 1.315, "e": 2.844, "t": "disappeared?"}, {"s": 2.844, "e": 5.208, "t": "It's already happening!"}, {"s": 5.208, "e": 6.403, "t": "New Zealand:"}, {"s": 6.403, "e": 7.384, "t": "one and two cent"}, {"s": 7.384, "e": 8.067, "t": "coins,"}, {"s": 8.067, "e": 10.046, "t": "gone in nineteen ninety."}, {"s": 10.046, "e": 11.07, "t": "Australia:"}, {"s": 11.07, "e": 12.179, "t": "gone in nineteen ninety"}, {"s": 12.179, "e": 12.777, "t": "two,"}, {"s": 12.777, "e": 13.886, "t": "and prices are rounded"}, {"s": 13.886, "e": 15.682, "t": "to five cents."}, {"s": 15.682, "e": 16.578, "t": "Finland:"}, {"s": 16.578, "e": 17.389, "t": "no one or two"}, {"s": 17.389, "e": 18.626, "t": "cent euro coins in"}, {"s": 18.626, "e": 19.735, "t": "everyday use,"}, {"s": 19.735, "e": 20.887, "t": "so prices are rounded"}, {"s": 20.887, "e": 22.252, "t": "instead."}, {"s": 22.252, "e": 23.404, "t": "The Netherlands:"}, {"s": 23.404, "e": 24.343, "t": "rounding too,"}, {"s": 24.343, "e": 26.242, "t": "since two thousand four."}, {"s": 26.242, "e": 26.967, "t": "Canada:"}, {"s": 26.967, "e": 27.821, "t": "said goodbye to the"}, {"s": 27.821, "e": 29.442, "t": "penny in twenty thirteen,"}, {"s": 29.442, "e": 30.509, "t": "because each one cost"}, {"s": 30.509, "e": 31.191, "t": "more than a cent"}, {"s": 31.191, "e": 32.419, "t": "to make."}, {"s": 32.419, "e": 34.323, "t": "But here's the twist."}, {"s": 34.323, "e": 35.133, "t": "America:"}, {"s": 35.133, "e": 36.2, "t": "the US Mint made"}, {"s": 36.2, "e": 37.395, "t": "its very last penny"}, {"s": 37.395, "e": 38.803, "t": "in twenty twenty five,"}, {"s": 38.803, "e": 39.741, "t": "after more than two"}, {"s": 39.741, "e": 41.753, "t": "hundred thirty years!"}, {"s": 41.753, "e": 42.435, "t": "Do you still use"}, {"s": 42.435, "e": 43.713, "t": "pennies?"}, {"s": 43.713, "e": 44.695, "t": "Comment below,"}, {"s": 44.695, "e": 46.017, "t": "and subscribe for more!"}]