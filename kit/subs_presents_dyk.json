[{"s": 0, "e": 1.017, "t": "When do kids open"}, {"s": 1.017, "e": 2.92, "t": "their Christmas presents?"}, {"s": 2.92, "e": 3.688, "t": "It depends where you"}, {"s": 3.688, "e": 4.945, "t": "live!"}, {"s": 4.945, "e": 5.969, "t": "America:"}, {"s": 5.969, "e": 7.079, "t": "December twenty fifth,"}, {"s": 7.079, "e": 8.762, "t": "on Christmas morning."}, {"s": 8.762, "e": 10.042, "t": "Australia:"}, {"s": 10.042, "e": 11.535, "t": "December twenty fifth too,"}, {"s": 11.535, "e": 12.559, "t": "and then it's off"}, {"s": 12.559, "e": 14.097, "t": "to the beach!"}, {"s": 14.097, "e": 15.036, "t": "Germany:"}, {"s": 15.036, "e": 15.975, "t": "Christmas Eve,"}, {"s": 15.975, "e": 17.775, "t": "December twenty fourth."}, {"s": 17.775, "e": 18.97, "t": "The Netherlands:"}, {"s": 18.97, "e": 20.079, "t": "December fifth,"}, {"s": 20.079, "e": 22.165, "t": "when Sinterklaas visits."}, {"s": 22.165, "e": 23.061, "t": "Russia:"}, {"s": 23.061, "e": 23.957, "t": "New Year's Day,"}, {"s": 23.957, "e": 25.923, "t": "from Grandfather Frost."}, {"s": 25.923, "e": 27.697, "t": "But here's the twist."}, {"s": 27.697, "e": 28.679, "t": "Spain:"}, {"s": 28.679, "e": 29.703, "t": "many kids wait until"}, {"s": 29.703, "e": 30.727, "t": "January sixth,"}, {"s": 30.727, "e": 31.58, "t": "when the Three Kings"}, {"s": 31.58, "e": 33.162, "t": "bring the gifts!"}, {"s": 33.162, "e": 33.802, "t": "When do you open"}, {"s": 33.802, "e": 35.093, "t": "yours?"}, {"s": 35.093, "e": 35.989, "t": "Comment below,"}, {"s": 35.989, "e": 36.842, "t": "and subscribe!"}]