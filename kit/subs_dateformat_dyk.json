[{"s": 0, "e": 1.614, "t": "Is December eleventh written"}, {"s": 1.614, "e": 2.937, "t": "twelve eleven,"}, {"s": 2.937, "e": 4.79, "t": "or eleven twelve?"}, {"s": 4.79, "e": 5.729, "t": "It depends where you"}, {"s": 5.729, "e": 6.917, "t": "live!"}, {"s": 6.917, "e": 8.026, "t": "Australia:"}, {"s": 8.026, "e": 8.965, "t": "day first,"}, {"s": 8.965, "e": 9.818, "t": "then the month,"}, {"s": 9.818, "e": 11.652, "t": "so it's eleven twelve."}, {"s": 11.652, "e": 12.676, "t": "The UK:"}, {"s": 12.676, "e": 14.362, "t": "day first too."}, {"s": 14.362, "e": 15.13, "t": "Japan:"}, {"s": 15.13, "e": 15.898, "t": "year first,"}, {"s": 15.898, "e": 16.623, "t": "then month,"}, {"s": 16.623, "e": 17.477, "t": "then day,"}, {"s": 17.477, "e": 18.586, "t": "which makes dates easy"}, {"s": 18.586, "e": 19.915, "t": "to sort."}, {"s": 19.915, "e": 20.47, "t": "China:"}, {"s": 20.47, "e": 21.665, "t": "year first as well,"}, {"s": 21.665, "e": 22.475, "t": "the same as the"}, {"s": 22.475, "e": 24.321, "t": "international standard."}, {"s": 24.321, "e": 24.961, "t": "Canada:"}, {"s": 24.961, "e": 25.772, "t": "you can find all"}, {"s": 25.772, "e": 26.753, "t": "three formats,"}, {"s": 26.753, "e": 27.649, "t": "sometimes on the same"}, {"s": 27.649, "e": 28.849, "t": "street!"}, {"s": 28.849, "e": 30.745, "t": "But here's the twist."}, {"s": 30.745, "e": 31.641, "t": "America:"}, {"s": 31.641, "e": 32.537, "t": "month first,"}, {"s": 32.537, "e": 33.518, "t": "then day,"}, {"s": 33.518, "e": 33.987, "t": "and it's one of"}, {"s": 33.987, "e": 35.011, "t": "the only countries in"}, {"s": 35.011, "e": 35.779, "t": "the world that does"}, {"s": 35.779, "e": 36.163, "t": "it,"}, {"s": 36.163, "e": 36.931, "t": "which is why nine"}, {"s": 36.931, "e": 39.237, "t": "eleven means September!"}, {"s": 39.237, "e": 39.791, "t": "How do you write"}, {"s": 39.791, "e": 41.153, "t": "the date?"}, {"s": 41.153, "e": 42.049, "t": "Comment below,"}, {"s": 42.049, "e": 43.286, "t": "and subscribe for more!"}]