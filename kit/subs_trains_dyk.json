[{"s": 0, "e": 1.23, "t": "What if America had"}, {"s": 1.23, "e": 3.284, "t": "bullet trains everywhere?"}, {"s": 3.284, "e": 4.877, "t": "Let's compare."}, {"s": 4.877, "e": 6.115, "t": "Australia:"}, {"s": 6.115, "e": 7.053, "t": "no high speed rail"}, {"s": 7.053, "e": 7.736, "t": "at all,"}, {"s": 7.736, "e": 8.973, "t": "so most people fly"}, {"s": 8.973, "e": 10.86, "t": "between big cities."}, {"s": 10.86, "e": 11.671, "t": "America:"}, {"s": 11.671, "e": 12.823, "t": "the new Acela reaches"}, {"s": 12.823, "e": 13.975, "t": "one hundred sixty miles"}, {"s": 13.975, "e": 14.743, "t": "per hour,"}, {"s": 14.743, "e": 15.724, "t": "but only on short"}, {"s": 15.724, "e": 17.064, "t": "stretches."}, {"s": 17.064, "e": 17.917, "t": "Germany:"}, {"s": 17.917, "e": 19.069, "t": "ICE trains at three"}, {"s": 19.069, "e": 21.265, "t": "hundred kilometers per hour."}, {"s": 21.265, "e": 22.161, "t": "France:"}, {"s": 22.161, "e": 23.399, "t": "TGV trains at three"}, {"s": 23.399, "e": 24.38, "t": "hundred twenty,"}, {"s": 24.38, "e": 25.404, "t": "and one test train"}, {"s": 25.404, "e": 26.727, "t": "hit five hundred seventy"}, {"s": 26.727, "e": 27.926, "t": "four!"}, {"s": 27.926, "e": 28.737, "t": "Japan:"}, {"s": 28.737, "e": 29.889, "t": "the Shinkansen at three"}, {"s": 29.889, "e": 31.169, "t": "hundred twenty too,"}, {"s": 31.169, "e": 32.065, "t": "famous for being on"}, {"s": 32.065, "e": 33.823, "t": "time to the second."}, {"s": 33.823, "e": 35.669, "t": "But here's the twist."}, {"s": 35.669, "e": 36.522, "t": "China:"}, {"s": 36.522, "e": 37.845, "t": "over forty five thousand"}, {"s": 37.845, "e": 39.082, "t": "kilometers of high speed"}, {"s": 39.082, "e": 39.722, "t": "rail,"}, {"s": 39.722, "e": 40.405, "t": "more than the rest"}, {"s": 40.405, "e": 42.442, "t": "of the world combined!"}, {"s": 42.442, "e": 43.039, "t": "Would you ride a"}, {"s": 43.039, "e": 44.511, "t": "bullet train?"}, {"s": 44.511, "e": 45.535, "t": "Comment below,"}, {"s": 45.535, "e": 46.815, "t": "and subscribe for more!"}]