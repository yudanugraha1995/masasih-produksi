[{"s": 0, "e": 0.846, "t": "What if your road"}, {"s": 0.846, "e": 1.785, "t": "trip broke a world"}, {"s": 1.785, "e": 3.06, "t": "record?"}, {"s": 3.06, "e": 4.44, "t": "Let's look."}, {"s": 4.44, "e": 5.251, "t": "China:"}, {"s": 5.251, "e": 6.36, "t": "has the world's biggest"}, {"s": 6.36, "e": 7.64, "t": "expressway network,"}, {"s": 7.64, "e": 8.835, "t": "about one hundred eighty"}, {"s": 8.835, "e": 10.764, "t": "thousand kilometers."}, {"s": 10.764, "e": 11.617, "t": "Norway:"}, {"s": 11.617, "e": 12.94, "t": "the Lærdal Tunnel runs"}, {"s": 12.94, "e": 14.177, "t": "over twenty four kilometers"}, {"s": 14.177, "e": 15.159, "t": "through a mountain,"}, {"s": 15.159, "e": 16.268, "t": "the longest road tunnel"}, {"s": 16.268, "e": 17.665, "t": "on Earth."}, {"s": 17.665, "e": 18.391, "t": "Turkey:"}, {"s": 18.391, "e": 19.415, "t": "has the world's longest"}, {"s": 19.415, "e": 21.036, "t": "suspension bridge span,"}, {"s": 21.036, "e": 22.925, "t": "over two kilometers."}, {"s": 22.925, "e": 23.863, "t": "Japan:"}, {"s": 23.863, "e": 25.015, "t": "some roads play music"}, {"s": 25.015, "e": 25.741, "t": "when you drive over"}, {"s": 25.741, "e": 26.466, "t": "them at the right"}, {"s": 26.466, "e": 27.63, "t": "speed!"}, {"s": 27.63, "e": 28.654, "t": "Australia:"}, {"s": 28.654, "e": 29.635, "t": "the Eyre Highway has"}, {"s": 29.635, "e": 30.787, "t": "a dead straight stretch"}, {"s": 30.787, "e": 31.897, "t": "of about one hundred"}, {"s": 31.897, "e": 33.305, "t": "forty six kilometers,"}, {"s": 33.305, "e": 34.158, "t": "with no turns at"}, {"s": 34.158, "e": 35.299, "t": "all!"}, {"s": 35.299, "e": 37.127, "t": "But here's the twist."}, {"s": 37.127, "e": 37.98, "t": "America:"}, {"s": 37.98, "e": 39.004, "t": "has the largest road"}, {"s": 39.004, "e": 40.199, "t": "network on Earth,"}, {"s": 40.199, "e": 40.839, "t": "over six and a"}, {"s": 40.839, "e": 42.46, "t": "half million kilometers,"}, {"s": 42.46, "e": 43.143, "t": "enough to reach the"},