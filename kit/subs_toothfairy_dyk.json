[{"s": 0, "e": 0.803, "t": "What if the tooth"}, {"s": 0.803, "e": 1.998, "t": "fairy was actually a"}, {"s": 1.998, "e": 3.321, "t": "mouse?"}, {"s": 3.321, "e": 4.884, "t": "Let's check."}, {"s": 4.884, "e": 5.652, "t": "America:"}, {"s": 5.652, "e": 6.676, "t": "the tooth fairy leaves"}, {"s": 6.676, "e": 7.913, "t": "money under your pillow,"}, {"s": 7.913, "e": 8.937, "t": "about six dollars a"}, {"s": 8.937, "e": 10.502, "t": "tooth on average!"}, {"s": 10.502, "e": 11.355, "t": "Australia:"}, {"s": 11.355, "e": 13.139, "t": "the tooth fairy too."}, {"s": 13.139, "e": 14.12, "t": "The UK:"}, {"s": 14.12, "e": 14.931, "t": "the tooth fairy as"}, {"s": 14.931, "e": 15.528, "t": "well,"}, {"s": 15.528, "e": 16.765, "t": "usually leaving a shiny"}, {"s": 16.765, "e": 17.957, "t": "coin."}, {"s": 17.957, "e": 18.981, "t": "Mexico:"}, {"s": 18.981, "e": 20.133, "t": "Ratón Pérez,"}, {"s": 20.133, "e": 21.242, "t": "a little mouse,"}, {"s": 21.242, "e": 22.827, "t": "takes your tooth!"}, {"s": 22.827, "e": 23.638, "t": "France:"}, {"s": 23.638, "e": 24.961, "t": "la petite souris,"}, {"s": 24.961, "e": 25.942, "t": "the little mouse,"}, {"s": 25.942, "e": 26.881, "t": "hides a coin under"}, {"s": 26.881, "e": 28.207, "t": "the pillow."}, {"s": 28.207, "e": 29.877, "t": "But here's the twist."}, {"s": 29.877, "e": 30.773, "t": "Japan:"}, {"s": 30.773, "e": 31.839, "t": "kids throw their lower"}, {"s": 31.839, "e": 32.693, "t": "teeth up onto the"}, {"s": 32.693, "e": 33.418, "t": "roof,"}, {"s": 33.418, "e": 34.442, "t": "and upper teeth down"}, {"s": 34.442, "e": 35.466, "t": "under the house,"}, {"s": 35.466, "e": 36.362, "t": "so new teeth grow"}, {"s": 36.362, "e": 37.791, "t": "in straight!"}, {"s": 37.791, "e": 38.901, "t": "Who visited you,"}, {"s": 38.901, "e": 39.797, "t": "the fairy or the"}, {"s": 39.797, "e": 41.111, "t": "mouse?"}, {"s": 41.111, "e": 42.135, "t": "Comment below,"}, {"s": 42.135, "e": 43.457, "t": "and subscribe for more!"}]