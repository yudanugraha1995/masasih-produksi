[{"s": 0, "e": 1.059, "t": "What if your country's"}, {"s": 1.059, "e": 2.083, "t": "flag had a secret"}, {"s": 2.083, "e": 3.277, "t": "story?"}, {"s": 3.277, "e": 4.707, "t": "Let's look."}, {"s": 4.707, "e": 5.56, "t": "Denmark:"}, {"s": 5.56, "e": 6.285, "t": "has one of the"}, {"s": 6.285, "e": 7.864, "t": "oldest national flags still"}, {"s": 7.864, "e": 8.547, "t": "in use,"}, {"s": 8.547, "e": 10.577, "t": "from the thirteen hundreds."}, {"s": 10.577, "e": 11.515, "t": "Switzerland:"}, {"s": 11.515, "e": 12.411, "t": "one of only two"}, {"s": 12.411, "e": 13.478, "t": "countries with a square"}, {"s": 13.478, "e": 14.161, "t": "flag,"}, {"s": 14.161, "e": 16.06, "t": "along with Vatican City."}, {"s": 16.06, "e": 16.956, "t": "Japan:"}, {"s": 16.956, "e": 18.279, "t": "its red sun flag"}, {"s": 18.279, "e": 19.473, "t": "only became the official"}, {"s": 19.473, "e": 21.095, "t": "national flag in nineteen"}, {"s": 21.095, "e": 22.547, "t": "ninety nine!"}, {"s": 22.547, "e": 23.401, "t": "Canada:"}, {"s": 23.401, "e": 24.638, "t": "the maple leaf flag"}, {"s": 24.638, "e": 25.705, "t": "only appeared in nineteen"}, {"s": 25.705, "e": 27.217, "t": "sixty five."}, {"s": 27.217, "e": 28.156, "t": "Australia:"}, {"s": 28.156, "e": 29.479, "t": "the Aboriginal flag,"}, {"s": 29.479, "e": 30.673, "t": "designed in nineteen seventy"}, {"s": 30.673, "e": 31.228, "t": "one,"}, {"s": 31.228, "e": 32.337, "t": "is also an official"}, {"s": 32.337, "e": 34.023, "t": "flag of the country."}, {"s": 34.023, "e": 35.901, "t": "But here's the twist."}, {"s": 35.901, "e": 36.797, "t": "America:"}, {"s": 36.797, "e": 38.504, "t": "today's fifty star flag"}, {"s": 38.504, "e": 39.315, "t": "was designed by a"}, {"s": 39.315, "e": 40.296, "t": "high school student for"}, {"s": 40.296, "e": 41.619, "t": "a class project,"}, {"s": 41.619, "e": 42.643, "t": "and his teacher gave"}, {"s": 42.643, "e": 44.511, "t": "it a B minus!"}, {"s": 44.511, "e": 45.279, "t": "What grade would you"}, {"s": 45.279, "e": 46.877, "t": "give your flag?"}, {"s": 46.877, "e": 47.944, "t": "Comment below,"}, {"s": 47.944, "e": 49.224, "t": "and subscribe for more!"}]