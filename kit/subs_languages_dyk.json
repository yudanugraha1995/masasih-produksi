[{"s": 0, "e": 0.931, "t": "What if your country"}, {"s": 0.931, "e": 1.785, "t": "had more than twenty"}, {"s": 1.785, "e": 3.264, "t": "languages?"}, {"s": 3.264, "e": 4.807, "t": "Let's count."}, {"s": 4.807, "e": 5.916, "t": "Australia:"}, {"s": 5.916, "e": 6.897, "t": "no official language at"}, {"s": 6.897, "e": 7.58, "t": "all,"}, {"s": 7.58, "e": 8.647, "t": "even though almost everyone"}, {"s": 8.647, "e": 10.195, "t": "speaks English!"}, {"s": 10.195, "e": 10.963, "t": "Canada:"}, {"s": 10.963, "e": 11.517, "t": "two,"}, {"s": 11.517, "e": 12.627, "t": "English and French,"}, {"s": 12.627, "e": 13.821, "t": "and every product label"}, {"s": 13.821, "e": 15.412, "t": "uses both."}, {"s": 15.412, "e": 16.393, "t": "Switzerland:"}, {"s": 16.393, "e": 17.161, "t": "four,"}, {"s": 17.161, "e": 17.844, "t": "German,"}, {"s": 17.844, "e": 18.356, "t": "French,"}, {"s": 18.356, "e": 20.891, "t": "Italian and Romansh."}, {"s": 20.891, "e": 21.915, "t": "South Africa:"}, {"s": 21.915, "e": 22.341, "t": "twelve,"}, {"s": 22.341, "e": 24.396, "t": "including sign language!"}, {"s": 24.396, "e": 25.164, "t": "India:"}, {"s": 25.164, "e": 26.487, "t": "twenty two languages listed"}, {"s": 26.487, "e": 27.809, "t": "in its constitution,"}, {"s": 27.809, "e": 30.094, "t": "and hundreds more spoken!"}, {"s": 30.094, "e": 31.967, "t": "But here's the twist."}, {"s": 31.967, "e": 32.821, "t": "America:"}, {"s": 32.821, "e": 33.973, "t": "had no official language"}, {"s": 33.973, "e": 34.997, "t": "for almost two hundred"}, {"s": 34.997, "e": 36.106, "t": "fifty years,"}, {"s": 36.106, "e": 36.917, "t": "until English was made"}, {"s": 36.917, "e": 38.495, "t": "official by executive order"}, {"s": 38.495, "e": 40.585, "t": "in twenty twenty five!"}, {"s": 40.585, "e": 41.481, "t": "How many languages do"}, {"s": 41.481, "e": 42.887, "t": "you speak?"}, {"s": 42.887, "e": 43.826, "t": "Comment below,"}, {"s": 43.826, "e": 45.063, "t": "and subscribe for more!"}]