[{"s": 0, "e": 0.718, "t": "What if there were"}, {"s": 0.718, "e": 2.834, "t": "more bikes than people?"}, {"s": 2.834, "e": 4.503, "t": "Let's ride."}, {"s": 4.503, "e": 5.313, "t": "America:"}, {"s": 5.313, "e": 6.295, "t": "less than one percent"}, {"s": 6.295, "e": 7.233, "t": "of workers bike to"}, {"s": 7.233, "e": 7.831, "t": "work,"}, {"s": 7.831, "e": 9.602, "t": "most people drive."}, {"s": 9.602, "e": 10.541, "t": "Australia:"}, {"s": 10.541, "e": 11.863, "t": "about one percent too,"}, {"s": 11.863, "e": 12.674, "t": "and wearing a helmet"}, {"s": 12.674, "e": 14.159, "t": "is the law."}, {"s": 14.159, "e": 14.97, "t": "Germany:"}, {"s": 14.97, "e": 15.781, "t": "around one in ten"}, {"s": 15.781, "e": 16.762, "t": "trips by bike,"}, {"s": 16.762, "e": 17.573, "t": "with bike lanes in"}, {"s": 17.573, "e": 19.06, "t": "most cities."}, {"s": 19.06, "e": 20.084, "t": "Japan:"}, {"s": 20.084, "e": 21.321, "t": "lots of mamachari,"}, {"s": 21.321, "e": 22.26, "t": "mom bikes with seats"}, {"s": 22.26, "e": 23.369, "t": "for kids and baskets"}, {"s": 23.369, "e": 24.953, "t": "for groceries!"}, {"s": 24.953, "e": 25.678, "t": "Denmark:"}, {"s": 25.678, "e": 26.745, "t": "in Copenhagen,"}, {"s": 26.745, "e": 27.897, "t": "almost half of commuters"}, {"s": 27.897, "e": 28.835, "t": "ride a bike,"}, {"s": 28.835, "e": 30.458, "t": "even in the snow!"}, {"s": 30.458, "e": 32.129, "t": "But here's the twist."}, {"s": 32.129, "e": 33.195, "t": "The Netherlands:"}, {"s": 33.195, "e": 34.305, "t": "about twenty three million"}, {"s": 34.305, "e": 34.945, "t": "bikes,"}, {"s": 34.945, "e": 36.225, "t": "more bikes than people,"}, {"s": 36.225, "e": 37.121, "t": "and Utrecht has a"}, {"s": 37.121, "e": 38.273, "t": "parking garage for over"}, {"s": 38.273, "e": 40.259, "t": "twelve thousand bikes!"}, {"s": 40.259, "e": 40.771, "t": "Bike,"}, {"s": 40.771, "e": 42.414, "t": "car or bus?"}, {"s": 42.414, "e": 43.225, "t": "Comment below,"}, {"s": 43.225, "e": 44.504, "t": "and subscribe for more!"}]