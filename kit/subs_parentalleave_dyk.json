[{"s": 0, "e": 1.017, "t": "What if new parents"}, {"s": 1.017, "e": 1.699, "t": "got more than a"}, {"s": 1.699, "e": 3.081, "t": "year off?"}, {"s": 3.081, "e": 4.627, "t": "Let's compare."}, {"s": 4.627, "e": 5.608, "t": "Australia:"}, {"s": 5.608, "e": 6.589, "t": "twenty six weeks of"}, {"s": 6.589, "e": 8.375, "t": "government paid leave."}, {"s": 8.375, "e": 9.314, "t": "The UK:"}, {"s": 9.314, "e": 10.295, "t": "up to thirty nine"}, {"s": 10.295, "e": 12.413, "t": "weeks of statutory pay."}, {"s": 12.413, "e": 13.181, "t": "Canada:"}, {"s": 13.181, "e": 14.077, "t": "up to eighteen months"}, {"s": 14.077, "e": 14.845, "t": "of benefits,"}, {"s": 14.845, "e": 15.783, "t": "if parents choose the"}, {"s": 15.783, "e": 17.477, "t": "extended option."}, {"s": 17.477, "e": 18.33, "t": "Norway:"}, {"s": 18.33, "e": 19.269, "t": "forty nine weeks at"}, {"s": 19.269, "e": 20.079, "t": "full pay,"}, {"s": 20.079, "e": 21.359, "t": "with fifteen weeks just"}, {"s": 21.359, "e": 22.81, "t": "for dad."}, {"s": 22.81, "e": 23.663, "t": "Sweden:"}, {"s": 23.663, "e": 25.242, "t": "four hundred eighty days,"}, {"s": 25.242, "e": 27.336, "t": "shared by both parents!"}, {"s": 27.336, "e": 29.185, "t": "But here's the twist."}, {"s": 29.185, "e": 30.081, "t": "America:"}, {"s": 30.081, "e": 31.403, "t": "no national paid parental"}, {"s": 31.403, "e": 32.257, "t": "leave at all,"}, {"s": 32.257, "e": 33.579, "t": "just twelve weeks unpaid"}, {"s": 33.579, "e": 34.731, "t": "for some workers,"}, {"s": 34.731, "e": 35.371, "t": "making it one of"}, {"s": 35.371, "e": 36.609, "t": "the only rich countries"}, {"s": 36.609, "e": 37.945, "t": "without it!"}, {"s": 37.945, "e": 39.012, "t": "How long should parental"}, {"s": 39.012, "e": 40.386, "t": "leave be?"}, {"s": 40.386, "e": 41.367, "t": "Comment below,"}, {"s": 41.367, "e": 42.647, "t": "and subscribe for more!"}]