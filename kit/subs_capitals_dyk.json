[{"s": 0, "e": 0.803, "t": "What if your biggest"}, {"s": 0.803, "e": 2.754, "t": "city wasn't the capital?"}, {"s": 2.754, "e": 4.503, "t": "It happens a lot."}, {"s": 4.503, "e": 5.271, "t": "America:"}, {"s": 5.271, "e": 6.636, "t": "the capital is Washington"}, {"s": 6.636, "e": 7.404, "t": "DC,"}, {"s": 7.404, "e": 8.215, "t": "not New York,"}, {"s": 8.215, "e": 8.983, "t": "which has more than"}, {"s": 8.983, "e": 9.921, "t": "ten times as many"}, {"s": 9.921, "e": 11.083, "t": "people."}, {"s": 11.083, "e": 12.149, "t": "Australia:"}, {"s": 12.149, "e": 12.832, "t": "Canberra,"}, {"s": 12.832, "e": 13.856, "t": "not Sydney,"}, {"s": 13.856, "e": 15.008, "t": "built as a compromise"}, {"s": 15.008, "e": 17.264, "t": "between Sydney and Melbourne!"}, {"s": 17.264, "e": 18.117, "t": "Canada:"}, {"s": 18.117, "e": 18.8, "t": "Ottawa,"}, {"s": 18.8, "e": 19.739, "t": "not Toronto,"}, {"s": 19.739, "e": 21.755, "t": "picked by Queen Victoria."}, {"s": 21.755, "e": 22.737, "t": "Brazil:"}, {"s": 22.737, "e": 23.633, "t": "Brasília,"}, {"s": 23.633, "e": 24.785, "t": "not São Paulo,"}, {"s": 24.785, "e": 25.809, "t": "a whole new city"}, {"s": 25.809, "e": 26.875, "t": "built in about four"}, {"s": 26.875, "e": 28.107, "t": "years."}, {"s": 28.107, "e": 28.832, "t": "Turkey:"}, {"s": 28.832, "e": 29.515, "t": "Ankara,"}, {"s": 29.515, "e": 30.795, "t": "not Istanbul,"}, {"s": 30.795, "e": 31.819, "t": "even though Istanbul is"}, {"s": 31.819, "e": 33.545, "t": "far more famous."}, {"s": 33.545, "e": 35.619, "t": "But here's the twist."}, {"s": 35.619, "e": 36.557, "t": "South Africa:"}, {"s": 36.557, "e": 37.923, "t": "it has three capitals,"}, {"s": 37.923, "e": 39.373, "t": "Pretoria for the government,"}, {"s": 39.373, "e": 40.653, "t": "Cape Town for parliament,"}, {"s": 40.653, "e": 42.019, "t": "and Bloemfontein for the"}, {"s": 42.019, "e": 43.815, "t": "top appeals court!"}, {"s": 43.815, "e": 44.412, "t": "Did you know your"}, {"s": 44.412, "e": 45.695, "t": "capital?"}, {"s": 45.695, "e": 46.591, "t": "Comment below,"}, {"s": 46.591, "e": 47.956, "t": "and subscribe for more!"}]