[{"s": 0.072, "e": 0.56, "t": "Woyyy!"}, {"s": 0.6, "e": 2.4, "t": "Jangan telan biji semangka,"}, {"s": 2.44, "e": 4.08, "t": "nanti tumbuh pohon di"}, {"s": 4.14, "e": 4.76, "t": "perut!"}, {"s": 5.24, "e": 5.88, "t": "Masa sih?"}, {"s": 6.145, "e": 6.8, "t": "Yuk kita cek!"}, {"s": 7.04, "e": 8.84, "t": "Biji butuh tanah,"}, {"s": 8.93, "e": 9.4, "t": "air,"}, {"s": 9.5, "e": 10.48, "t": "cahaya matahari,"}, {"s": 10.52, "e": 12.16, "t": "dan oksigen buat tumbuh."}, {"s": 12.293, "e": 13.36, "t": "Di dalam perut nggak"}, {"s": 13.4, "e": 14.24, "t": "ada satu pun yang"}, {"s": 14.32, "e": 15.0, "t": "cocok."}, {"s": 15.07, "e": 16.24, "t": "Malah ada asam lambung"}, {"s": 16.272, "e": 17.52, "t": "yang kuat banget."}, {"s": 17.76, "e": 19.04, "t": "Jadi biji semangka yang"}, {"s": 19.08, "e": 20.56, "t": "ketelan cuma lewat saluran"}, {"s": 20.64, "e": 21.28, "t": "cerna,"}, {"s": 21.32, "e": 22.88, "t": "lalu keluar bersama kotoran"}, {"s": 22.92, "e": 24.08, "t": "dalam satu sampai tiga"}, {"s": 24.16, "e": 24.8, "t": "hari."}, {"s": 25.254, "e": 26.36, "t": "Plot twist-nya..."}, {"s": 26.43, "e": 27.6, "t": "biji semangka malah bisa"}, {"s": 27.64, "e": 28.32, "t": "dimakan!"}, {"s": 28.48, "e": 29.68, "t": "Di beberapa negara,"}, {"s": 29.72, "e": 31.2, "t": "biji semangka disangrai jadi"}, {"s": 31.26, "e": 32.0, "t": "camilan,"}, {"s": 32.053, "e": 33.2, "t": "isinya protein,"}, {"s": 33.272, "e": 34.0, "t": "magnesium,"}, {"s": 34.02, "e": 34.88, "t": "dan lemak sehat."}, {"s": 35.04, "e": 36.48, "t": "Tapi tetap hati-hati buat"}, {"s": 36.512, "e": 37.28, "t": "anak kecil,"}, {"s": 37.326, "e": 38.4, "t": "karena biji bisa bikin"}, {"s": 38.5, "e": 39.12, "t": "tersedak."}, {"s": 39.22, "e": 40.48, "t": "Kunyah pelan-pelan,"}, {"s": 40.52, "e": 41.76, "t": "dan jangan makan sambil"}, {"s": 41.8, "e": 42.72, "t": "lari-larian."}, {"s": 43.09, "e": 44.16, "t": "Kamu tim makan semangka"}, {"s": 44.208, "e": 45.52, "t": "sama bijinya atau tim"}, {"s": 45.573,